{#- https://github.com/zensical/zensical/blob/master/zensical/templates/sitemap.xml

   Zensical's own sitemap template plus one clause: a page declaring `robots: noindex` is left
   out. The per-page <lastmod> MkDocs' hook computed from git is added by the publish
   (publish-tool/README.md). -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for page in pages -%}
    {%- if page.canonical_url and not (page.meta and page.meta.robots and "noindex" in page.meta.robots) %}
      <url>
        <loc>{{ page.canonical_url }}</loc>
      </url>
    {%- endif -%}
  {%- endfor %}
</urlset>
