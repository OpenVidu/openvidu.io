<!DOCTYPE html>
<!-- Generated by ovweb from the "{{ rule_id }}" rule in publish-tool/ovweb.yaml.
     Do not edit: the next publish overwrites this file. -->
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="robots" content="{{ robots }}">
<meta http-equiv="refresh" content="0; url={{ to }}">
{% if canonical %}
<link rel="canonical" href="{{ canonical }}">
{% endif %}
<title>{{ title }}</title>
<script>
  // The target is relative on purpose. `latest` is a symlink to the newest version folder,
  // so this same file is served at /latest/ and at /<version>/; resolving the target against
  // the document URL keeps the visitor inside whichever path served the page, and never
  // leaks a version number to /latest/. Resolution against location.href is exactly what the
  // meta refresh above does, so both paths agree — including when the URL names index.html.
  (function () {
    // `to_js` is JSON-encoded and marked safe deliberately: the content of a <script>
    // element is raw text, where character references are not decoded, so an HTML-escaped
    // quote would reach the parser as its literal escape sequence and break the script.
    // ovweb rejects any target holding a quote, an angle bracket or whitespace, which is
    // what makes emitting it unescaped safe.
    var target = new URL({{ to_js | safe }}, location.href);
{% if preserve_query_and_hash %}
    // Forward the incoming query string and fragment; the old redirect dropped both.
    target.search = target.search || location.search;
    target.hash = target.hash || location.hash;
{% endif %}
    // replace() rather than assigning location.href: no history entry, so Back still works.
    location.replace(target.href);
  })();
</script>
</head>
<body>
<p>{{ body }}</p>
<p>If you are not redirected automatically, <a href="{{ to }}">follow this link</a>.</p>
</body>
</html>
