<!DOCTYPE html>
<!-- Generated by ovweb from the "{{ rule_id }}" rule in publish-tool/ovweb.yaml.
     Do not edit: the next publish overwrites this file. -->
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="robots" content="{{ robots }}">
<meta http-equiv="refresh" content="0; url={{ to }}">
{% if canonical %}
<link rel="canonical" href="{{ canonical }}">
{% endif %}
<title>{{ title }}</title>
<script>
{% if relative %}
  // The target is relative because `latest` is a symlink to the newest version folder: this
  // same file is served at /latest/ and at /<version>/, and resolving against the document URL
  // keeps the visitor inside whichever one served the page.
{% else %}
  // The target is site-absolute: this page is served from exactly one URL, so there is no
  // second path to stay inside.
{% endif %}
  (function () {
    // Marked safe deliberately: a <script> element's content is raw text, where character
    // references are not decoded, so an HTML-escaped quote would reach the parser as its
    // literal escape sequence. ovweb rejects any target holding a quote, an angle bracket or
    // whitespace, which is what makes emitting it unescaped safe.
    var target = new URL({{ to_js | safe }}, location.href);
{% if preserve_query_and_hash %}
    target.search = target.search || location.search;
    target.hash = target.hash || location.hash;
{% endif %}
    // replace() rather than assigning location.href: no history entry, so Back still works.
    location.replace(target.href);
  })();
</script>
</head>
<body>
<p>{{ body }}</p>
<p>If you are not redirected automatically, <a href="{{ to }}">follow this link</a>.</p>
</body>
</html>
