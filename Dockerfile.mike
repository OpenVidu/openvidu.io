# Keep the tag in step with the mkdocs-material pin in publish-tool/pyproject.toml.
# `ovweb doctor --pins` fails when they disagree: a different theme version builds different
# markup, and the release-notes splice matches on that markup.
FROM squidfunk/mkdocs-material:9.8.2@sha256:fd13d78a4b1da637405c0336c9f0a4e0594b59271df106bd9cd64cae56cd1f38
RUN pip install mkdocs==1.6.1 pymdown-extensions==13.1 mkdocs-glightbox==0.5.3 mkdocs-llmstxt==0.5.1 mkdocs-rss-plugin==1.20.0 pygments==2.21.0 gitpython==3.2.1 selectolax==0.4.11
RUN pip install mike==2.2.0
ENTRYPOINT ["/sbin/tini", "--", "mike"]
CMD ["serve", "--dev-addr=0.0.0.0:8000"]
