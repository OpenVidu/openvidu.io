[21.093,"o","\r\n  # google_cloud_scheduler_job.scalein will be created\r\n  + resource \"google_cloud_scheduler_job\" \"scalein\" {\r\n      + attempt_deadline = \"300s\"\r\n      + deletion_policy  = \"DELETE\"\r\n      + description      = \"Trigger the OpenVidu scale-in function every 5 minutes\"\r\n      + id               = (known after apply)\r\n      + name             = \"openvidu-e2e-gcp-el-s113145-scale-scheduler\"\r\n      + paused           = (known after apply)\r\n      + project          = \"***\"\r\n      + region           = \"europe-west2\"\r\n      + schedule         = \"*/5 * * * *\"\r\n      + state            = (known after apply)\r\n      + time_zone        = \"UTC\"\r\n\r\n      + http_target {\r\n          + body        = \"eyJwcm9qZWN0X2lkIjoi***yIsInJlZ2lvbiI6ImV1cm9wZS13ZXN0MiIsInN0YWNrX25hbWUiOiJvcGVudmlkdS1lMmUtZ2NwLWVsLXMxMTMxNDUifQ==\"\r\n          + headers     = {\r\n              + \"Content-Type\" = \"application/json\"\r\n            }\r\n          + http_method = \"POST\"\r\n          + uri         = (known after apply)\r\n\r\n          + oidc_token {\r\n              + audience              = (known after apply)\r\n              + service_account_email = \"openvidu-e2e-5f1629-scalein-sa@***.iam.gserviceaccount.com\"\r\n            }\r\n        }\r\n    }\r\n"]
[21.094,"o","\r\n  # google_cloudfunctions2_function.scalein will be created\r\n  + resource \"google_cloudfunctions2_function\" \"scalein\" {\r\n      + deletion_policy  = \"DELETE\"\r\n      + description      = \"OpenVidu openvidu-e2e-gcp-el-s113145: abandon surplus media nodes for graceful scale-in\"\r\n      + effective_labels = {\r\n          + \"goog-terraform-provisioned\" = \"true\"\r\n        }\r\n      + environment      = (known after apply)\r\n      + id               = (known after apply)\r\n      + location         = \"europe-west2\"\r\n      + name             = \"openvidu-e2e-gcp-el-s113145-scalein-function\"\r\n      + project          = \"***\"\r\n      + state            = (known after apply)\r\n      + terraform_labels = {\r\n          + \"goog-terraform-provisioned\" = \"true\"\r\n        }\r\n      + update_time      = (known after apply)\r\n      + url              = (known after apply)\r\n\r\n      + build_config {\r\n          + build                 = (known after apply)\r\n          + docker_repository     = (known after apply)\r\n          + entry_point           = \"scalein_function\"\r\n          + environment_variables = (known after apply)\r\n          + runtime               = \"python311\"\r\n          + service_account       = (known after apply)\r\n\r\n          + automatic_update_policy (known after apply)\r\n\r\n          + source {\r\n              + storage_source {\r\n                  + bucket     = (known after apply)\r\n                  + generation = (known after apply)\r\n                  + object     = \"openvidu-e2e-gcp-el-s113145-scalein-function-3535131862e2c6da7247dec1eb431bfe.zip\"\r\n                }\r\n            }\r\n        }\r\n\r\n      + service_config {\r\n          + all_traffic_on_latest_revision   = true\r\n          + available_cpu                    = (known after apply)\r\n          + available_memory                 = \"512M\"\r\n          + direct_vpc_egress                = (known after apply)\r\n          + environment_variables            = {\r\n              + \"FIXED_NUMBER_OF_MEDIA_NODES\" = \"1\"\r\n              + \"PROJECT_ID\"                  = \"***\"\r\n              + \"REGION\"                      = \"europe-west2\"\r\n              + \"STACK_NAME\"                  = \"openvidu-e2e-gcp-el-s113145\"\r\n            }\r\n          + gcf_uri                          = (known after apply)\r\n          + ingress_settings                 = \"ALLOW_ALL\"\r\n          + max_instance_count               = 1\r\n          + max_instance_request_concurrency = (known after apply)\r\n          + service                          = (known after apply)\r\n          + service_account_email            = \"openvidu-e2e-5f1629-scalein-sa@***.iam.gserviceaccount.com\"\r\n          + timeout_seconds                  = 300\r\n          + uri                              = (known after apply)\r\n        }\r\n    }\r\n\r\n  # google_compute_address.public_ip[0] will be created\r\n  + resource \"google_compute_address\" \"public_ip\" {\r\n      + address            = (known after apply)\r\n      + address_id         = (known after apply)\r\n      + address_type       = \"EXTERNAL\"\r\n      + creation_timestamp = (known after apply)\r\n      + deletion_policy    = \"DELETE\"\r\n      + effective_labels   = {\r\n          + \"goog-terraform-provisioned\" = \"true\"\r\n        }\r\n      + id                 = (known after apply)\r\n      + label_fingerprint  = (known after apply)\r\n      + name               = \"openvidu-e2e-gcp-el-s113145-public-ip\"\r\n      + network_tier       = (known after apply)\r\n      + prefix_length      = (known after apply)\r\n      + project            = \"***\"\r\n      + purpose            = (known after apply)\r\n      + region             = \"europe-west2\"\r\n      + self_link          = (known after apply)\r\n      + subnetwork         = (known after apply)\r\n      + terraform_labels   = {\r\n          + \"goog-terraform-provisioned\" = \"true\"\r\n        }\r\n      + users              = (known after apply)\r\n    }\r\n\r\n  # google_compute_firewall.administration will be created\r\n  + resource \"google_compute_firewall\" \"administration\" {\r\n      + creation_timestamp = (known after apply)\r\n      + deletion_policy    = \"DELETE\"\r\n      + description        = \"Stack remote admin control protocol\"\r\n      + destination_ranges = (known after apply)\r\n      + direction          = (known after apply)\r\n      + enable_logging     = (known after apply)\r\n      + firewall_id        = (known after apply)\r\n      + id                 = (known after apply)\r\n      + name               = \"openvidu-e2e-gcp-el-s113145-administration\"\r\n      + network            = \"default\"\r\n      + priority           = 1000\r\n      + project            = \"***\"\r\n      + self_link          = (known after apply)\r\n      + source_ranges      = [\r\n          + \"0.0.0.0/0\",\r\n        ]\r\n      + target_tags        = [\r\n          + \"openvidu-e2e-gcp-el-s113145-master-node\",\r\n        ]\r\n\r\n      + allow {\r\n          + ports    = [\r\n              + \"6443\",\r\n            ]\r\n          + protocol = \"tcp\"\r\n        }\r\n    }\r\n"]
[21.094,"o","\r\n  # google_compute_firewall.master_from_media will be created\r\n  + resource \"google_compute_firewall\" \"master_from_media\" {\r\n      + creation_timestamp = (known after apply)\r\n      + deletion_policy    = \"DELETE\"\r\n      + destination_ranges = (known after apply)\r\n      + direction          = (known after apply)\r\n      + enable_logging     = (known after apply)\r\n      + firewall_id        = (known after apply)\r\n      + id                 = (known after apply)\r\n      + name               = \"openvidu-e2e-gcp-el-s113145-media-to-master\"\r\n      + network            = \"default\"\r\n      + priority           = 1000\r\n      + project            = \"***\"\r\n      + self_link          = (known after apply)\r\n      + source_tags        = [\r\n          + \"openvidu-e2e-gcp-el-s113145-media-node\",\r\n        ]\r\n      + target_tags        = [\r\n          + \"openvidu-e2e-gcp-el-s113145-master-node\",\r\n        ]\r\n\r\n      + allow {\r\n          + ports    = [\r\n              + \"6443\",\r\n              + \"10250\",\r\n            ]\r\n          + protocol = \"tcp\"\r\n        }\r\n      + allow {\r\n          + ports    = [\r\n              + \"8472\",\r\n            ]\r\n          + protocol = \"udp\"\r\n        }\r\n    }\r\n\r\n  # google_compute_firewall.media will be created\r\n  + resource \"google_compute_firewall\" \"media\" {\r\n      + creation_timestamp = (known after apply)\r\n      + deletion_policy    = \"DELETE\"\r\n      + destination_ranges = (known after apply)\r\n      + direction          = (known after apply)\r\n      + enable_logging     = (known after apply)\r\n      + firewall_id        = (known after apply)\r\n      + id                 = (known after apply)\r\n      + name               = \"openvidu-e2e-gcp-el-s113145-media-firewall\"\r\n      + network            = \"default\"\r\n      + priority           = 1000\r\n      + project            = \"***\"\r\n      + self_link          = (known after apply)\r\n      + source_ranges      = [\r\n          + \"0.0.0.0/0\",\r\n        ]\r\n      + target_tags        = [\r\n          + \"openvidu-e2e-gcp-el-s113145-media-node\",\r\n        ]\r\n\r\n      + allow {\r\n          + ports    = [\r\n              + \"22\",\r\n              + \"7881\",\r\n              + \"50000-60000\",\r\n            ]\r\n          + protocol = \"tcp\"\r\n        }\r\n      + allow {\r\n          + ports    = [\r\n              + \"443\",\r\n              + \"7885\",\r\n              + \"50000-60000\",\r\n            ]\r\n          + protocol = \"udp\"\r\n        }\r\n    }\r\n\r\n  # google_compute_firewall.media_from_cluster will be created\r\n  + resource \"google_compute_firewall\" \"media_from_cluster\" {\r\n      + creation_timestamp = (known after apply)\r\n      + deletion_policy    = \"DELETE\"\r\n      + destination_ranges = (known after apply)\r\n      + direction          = (known after apply)\r\n      + enable_logging     = (known after apply)\r\n      + firewall_id        = (known after apply)\r\n      + id                 = (known after apply)\r\n      + name               = \"openvidu-e2e-gcp-el-s113145-to-media\"\r\n      + network            = \"default\"\r\n      + priority           = 1000\r\n      + project            = \"***\"\r\n      + self_link          = (known after apply)\r\n      + source_tags        = [\r\n          + \"openvidu-e2e-gcp-el-s113145-master-node\",\r\n          + \"openvidu-e2e-gcp-el-s113145-media-node\",\r\n        ]\r\n      + target_tags        = [\r\n          + \"openvidu-e2e-gcp-el-s113145-media-node\",\r\n        ]\r\n\r\n      + allow {\r\n          + ports    = [\r\n              + \"10250\",\r\n            ]\r\n          + protocol = \"tcp\"\r\n        }\r\n      + allow {\r\n          + ports    = [\r\n              + \"8472\",\r\n            ]\r\n          + protocol = \"udp\"\r\n        }\r\n    }\r\n\r\n  # google_compute_firewall.media_health_check will be created\r\n  + res