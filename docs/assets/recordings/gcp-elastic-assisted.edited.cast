\r\n      \u001b[32m+\u001b[0m\u001b[0m instance_group_manager_id        = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m list_managed_instances_results   = \"PAGELESS\"\r\n      \u001b[32m+\u001b[0m\u001b[0m name                             = \"openvidu-e2e-gcp-el-s113145-media-node-group\"\r\n      \u001b[32m+\u001b[0m\u001b[0m project                          = \"***\"\r\n      \u001b[32m+\u001b[0m\u001b[0m region                           = \"europe-west2\"\r\n      \u001b[32m+\u001b[0m\u001b[0m self_link                        = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m status                           = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m target_size                      = 1\r\n      \u001b[32m+\u001b[0m\u001b[0m target_stopped_size              = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m target_suspended_size            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m wait_for_instances               = false\r\n      \u001b[32m+\u001b[0m\u001b[0m wait_for_instances_status        = \"STABLE\"\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m auto_healing_policies {\r\n          \u001b[32m+\u001b[0m\u001b[0m health_check      = (known after apply)\r\n          \u001b[32m+\u001b[0m\u001b[0m initial_delay_sec = 900\r\n        }\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m instance_lifecycle_policy (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m standby_policy (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m target_size_policy (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m update_policy (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m version {\r\n          \u001b[32m+\u001b[0m\u001b[0m instance_template = (known after apply)\r\n        }\r\n    }\r\n\r\n\u001b[1m  # google_project_iam_member.media_node_compute\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"google_project_iam_member\" \"media_node_compute\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m etag    = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id      = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m member  = \"serviceAccount:openvidu-e2e-g-5f1629-media-sa@***.iam.gserviceaccount.com\"\r\n      \u001b[32m+\u001b[0m\u001b[0m project = \"***\"\r\n      \u001b[32m+\u001b[0m\u001b[0m role    = \"roles/compute.instanceAdmin.v1\"\r\n    }\r\n\r\n\u001b[1m  # google_project_iam_member.scalein_compute\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"google_project_iam_member\" \"scalein_compute\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m etag    = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id      = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m member  = \"serviceAccount:openvidu-e2e-5f1629-scalein-sa@***.iam.gserviceaccount.com\"\r\n      \u001b[32m+\u001b[0m\u001b[0m project = \"***\"\r\n      \u001b[32m+\u001b[0m\u001b[0m role    = \"roles/compute.instanceAdmin.v1\"\r\n    }\r\n\r\n\u001b[1m  # google_project_service.cloudbuild_api\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"google_project_service\" \"cloudbuild_api\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m deletion_policy    = \"DELETE\"\r\n      \u001b[32m+\u001b[0m\u001b[0m disable_on_destroy = false\r\n      \u001b[32m+\u001b[0m\u001b[0m id                 = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m project            = \"***\"\r\n      \u001b[32m+\u001b[0m\u001b[0m service            = \"cloudbuild.googleapis.com\"\r\n    }\r\n\r\n\u001b[1m  # google_project_service.cloudfunctions_api\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"google_project_service\" \"cloudfunctions_api\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m deletion_policy    = \"DELETE\"\r\n      \u001b[32m+\u001b[0m\u001b[0m disable_on_destroy = false\r\n      \u001b[32m+\u001b[0m\u001b[0m id                 = (known after a