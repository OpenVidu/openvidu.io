[21.095,"o","\r\n  # google_compute_firewall.openvidu will be created\r\n  + resource \"google_compute_firewall\" \"openvidu\" {\r\n      + creation_timestamp = (known after apply)\r\n      + deletion_policy    = \"DELETE\"\r\n      + destination_ranges = (known after apply)\r\n      + direction          = (known after apply)\r\n      + enable_logging     = (known after apply)\r\n      + firewall_id        = (known after apply)\r\n      + id                 = (known after apply)\r\n      + name               = \"openvidu-e2e-gcp-el-s113145-pro-firewall\"\r\n      + network            = \"default\"\r\n      + priority           = 1000\r\n      + project            = \"***\"\r\n      + self_link          = (known after apply)\r\n      + source_ranges      = [\r\n          + \"0.0.0.0/0\",\r\n        ]\r\n      + target_tags        = [\r\n          + \"openvidu-e2e-gcp-el-s113145-master-node\",\r\n        ]\r\n\r\n      + allow {\r\n          + ports    = [\r\n              + \"22\",\r\n              + \"80\",\r\n              + \"443\",\r\n              + \"1935\",\r\n              + \"7881\",\r\n            ]\r\n          + protocol = \"tcp\"\r\n        }\r\n      + allow {\r\n          + ports    = [\r\n              + \"443\",\r\n              + \"7885\",\r\n              + \"50000-60000\",\r\n            ]\r\n          + protocol = \"udp\"\r\n        }\r\n    }\r\n\r\n  # google_compute_instance.openvidu_server will be created\r\n  + resource \"google_compute_instance\" \"openvidu_server\" {\r\n      + allow_stopping_for_update = true\r\n      + can_ip_forward            = false\r\n      + cpu_platform              = (known after apply)\r\n      + creation_timestamp        = (known after apply)\r\n      + current_status            = (known after apply)\r\n      + deletion_policy           = \"DELETE\"\r\n      + deletion_protection       = false\r\n      + effective_labels          = {\r\n          + \"goog-terraform-provisioned\" = \"true\"\r\n          + \"node-type\"                  = \"master\"\r\n          + \"stack\"                      = \"openvidu-e2e-gcp-el-s113145\"\r\n        }\r\n      + id                        = (known after apply)\r\n      + instance_id               = (known after apply)\r\n      + label_fingerprint         = (known after apply)\r\n      + labels                    = {\r\n          + \"node-type\" = \"master\"\r\n          + \"stack\"     = \"openvidu-e2e-gcp-el-s113145\"\r\n        }\r\n      + machine_type              = \"e2-standard-4\"\r\n      + metadata_fingerprint      = (known after apply)\r\n      + metadata_startup_script   = (sensitive value)\r\n      + min_cpu_platform          = (known after apply)\r\n      + name                      = \"openvidu-e2e-gcp-el-s113145-master-node\"\r\n      + project                   = \"***\"\r\n      + self_link                 = (known after apply)\r\n      + tags                      = [\r\n          + \"openvidu-e2e-gcp-el-s113145-master-node\",\r\n        ]\r\n      + tags_fingerprint          = (known after apply)\r\n      + terraform_labels          = {\r\n          + \"goog-terraform-provisioned\" = \"true\"\r\n          + \"node-type\"                  = \"master\"\r\n          + \"stack\"                      = \"openvidu-e2e-gcp-el-s113145\"\r\n        }\r\n      + zone                      = \"europe-west2-b\"\r\n\r\n      + boot_disk {\r\n          + auto_delete                = true\r\n          + device_name                = (known after apply)\r\n          + disk_encryption_key_sha256 = (known after apply)\r\n          + guest_os_features          = (known after apply)\r\n          + kms_key_self_link          = (known after apply)\r\n          + mode                       = \"READ_WRITE\"\r\n          + source                     = (known after apply)\r\n\r\n          + initialize_params {\r\n              + architecture           = (known after apply)\r\n              + image                  = \"ubuntu-os-cloud/ubuntu-2404-lts-amd64\"\r\n              + labels                 = (known after apply)\r\n              + provisioned_iops       = (known after apply)\r\n              + provisioned_throughput = (known after apply)\r\n              + resource_policies      = (known after apply)\r\n              + size                   = 200\r\n              + snapshot               = (known after apply)\r\n              + type                   = \"pd-balanced\"\r\n            }\r\n        }\r\n\r\n      + confidential_instance_config (known after apply)\r\n\r\n      + guest_accelerator (known after apply)\r\n\r\n      + network_interface {\r\n          + igmp_query                  = (known after apply)\r\n          + internal_ipv6_prefix_length = (known after apply)\r\n          + ipv6_access_type            = (known after apply)\r\n          + ipv6_address                = (known after apply)\r\n          + name                        = (known after apply)\r\n          + network                     = \"default\"\r\n          + network_attachment          = (known after apply)\r\n          + network_ip                  = (known after apply)\r\n          + parent_nic_name             = (known after apply)\r\n          + stack_type                  = (known after apply)\r\n          + subnetwork                  = (known after apply)\r\n          + subnetwork_project          = (known after apply)\r\n\r\n          + access_config {\r\n              + nat_ip       = (known after apply)\r\n              + network_tier = (known after apply)\r\n            }\r\n        }\r\n\r\n      + reservation_affinity (known after apply)\r\n\r\n      + scheduling (known after apply)\r\n\r\n      + service_account {\r\n          + email  = \"openvidu-e2e-gcp-el-5f1629-sa@***.iam.gserviceaccount.com\"\r\n          + scopes = [\r\n              + \"https://www.googleapis.com/auth/cloud-platform\",\r\n            ]\r\n        }\r\n    }\r\n"]
[21.096,"o","\r\n  # google_compute_instance_template.media_node will be created\r\n  + resource \"google_compute_instance_template\" \"media_node\" {\r\n      + can_ip_forward          = false\r\n      + creation_timestamp      = (known after apply)\r\n      + effective_labels        = {\r\n          + \"goog-terraform-provisioned\" = \"true\"\r\n          + \"node-type\"                  = \"media\"\r\n          + \"stack\"                      = \"openvidu-e2e-gcp-el-s113145\"\r\n        }\r\n      + id                      = (known after apply)\r\n      + labels                  = {\r\n          + \"node-type\" = \"media\"\r\n          + \"stack\"     = \"openvidu-e2e-gcp-el-s113145\"\r\n        }\r\n      + machine_type            = \"e2-standard-8\"\r\n      + metadata_fingerprint    = (known after apply)\r\n      + metadata_startup_script = <<-EOT\r\n            #!/bin/bash -x\r\n            set -eu -o pipefail\r\n            \r\n            # Runs on EVERY boot; joining is a one-off (the node comes back by itself afterwards).\r\n            if [ -f /opt/openvidu/.bootstrap-complete ]; then\r\n              echo \"[startup] this media node has already joined the cluster\"\r\n              exit 0\r\n            fi\r\n            install -d -m 0755 /opt/openvidu\r\n            \r\n            export DEBIAN_FRONTEND=noninteractive\r\n            echo \"DPkg::Lock::Timeout \\\"-1\\\";\" > /etc/apt/apt.conf.d/99timeout\r\n            apt-get update\r\n            apt-get install -y curl ca-certificates apt-transport-https gnupg jq\r\n            \r\n            # gcloud, because the join credentials live in Secret Manager. Version-pinned like\r\n            # the compose stacks, with a fallback so a rotated-out build in the apt repo cannot\r\n            # kill the bootstrap.\r\n            GCLOUD_VERSION=592.0.0\r\n            if ! command -v gcloud >/dev/null 2>&1; then\r\n              curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg\r\n              echo \"deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main\" > /etc/apt/sources.list.d/google-cloud-sdk.list\r\n              apt-get update\r\n              apt-get install -y google-cloud-cli=${GCLOUD_VERSION}-0 || apt-get install -y google-cloud-cli\r\n            fi\r\n            \r\n            # ---- Health watchdog ----\r\n            # Replaces this node with a new one when LiveKit stays unhealthy or the bootstrap fails\r\n            # (see openvidu-media-health.sh). Installed before the join, so that a node whose bootstrap\r\n            # fails or hangs is replaced too; not enabled in a deployedBy=client stack, whose nodes\r\n            # stay up unjoined on purpose. A failure marker left by an earlier boot is cleared: this\r\n            # boot tries again.\r\n            mkdir -p /var/lib/openvidu-media-health /etc/openvidu\r\n            rm -f /var/lib/openvidu-media-health/bootstrap-failed\r\n            cat > /usr/local/bin/openvidu-media-health.sh << 'HEALTH_EOF'\r\n            #!/bin/bash\r\n            # OpenVidu Media Node health watchdog (Kubernetes).\r\n            #\r\n            # Asks the cloud to replace this Media Node with a new one, keeping the number of Media\r\n            # Nodes, through /usr/local/bin/openvidu-media-replace.sh, when:\r\n            #   - its bootstrap failed (the user data wrote the bootstrap-failed marker): after a\r\n            #     cool-down, so a persistent failure does not churn nodes and can be inspected,\r\n            #   - its bootstrap did not finish BOOTSTRAP_DEADLINE_SEC after boot,\r\n            #   - LiveKit fails its health check (HTTP 200 on PROBE_URL): for HARD_UNHEALTHY_AFTER_SEC\r\n            #     while it is down (connection refused or closed), or for SOFT_UNHEALTHY_AFTER_SEC\r\n            #     while it answers an error or times out. Soft failures are not counted while the CPU\r\n            #     is saturated (an overloaded LiveKit reports Not Ready), and no failure is counted in\r\n            #     the WARMUP_SEC after the LiveKit pod was created on this node or the node joined.\r\n            # Nothing is replaced while the cluster does not serve: no control-plane server answers,\r\n            # or none of the Redis endpoints LiveKit needs is serving. Such an outage fails the health\r\n            # check of every Media Node at once, and a new node could not join either; LiveKit\r\n            # failures are not counted until the cluster serves again. Once requested, the\r\n            # replacement is requested again every REPLACE_RETRY_SEC until the node goes away.\r\n            #\r\n            # Settings: /etc/openvidu/media-health.env (sourced every cycle; CONTROL_PLANE=\"host:port\")\r\n            # Pause:    touch /etc/openvidu/media-health.disabled (scale-in uses /run/openvidu-media-health.paused)\r\n            # Logs:     journalctl -u openvidu-media-health\r\n            #\r\n            # This file is embedded verbatim in CloudFormation !Sub blocks, Bicep strings and Terraform\r\n            # heredocs, so it must never contain a dollar sign or a percent sign followed by an opening\r\n            # brace, nor two opening braces in a row.\r\n            \r\n            STATE_DIR=/var/lib/openvidu-media-health\r\n            INSTALLED_MARKER=\"$STATE_DIR/installed\"\r\n            BOOTSTRAP_FAILED_MARKER=\"$STATE_DIR/bootstrap-failed\"\r\n            REPLACE_SCRIPT=/usr/local/bin/openvidu-media-replace.sh\r\n            ENV_FILE=/etc/openvidu/media-health.env\r\n            PAUSE_FILE=/etc/openvidu/media-health.disabled\r\n            DRAIN_PAUSE_FILE=/run/openvidu-media-health.paused\r\n            # The node agent's kube-proxy credential: it may list EndpointSlices cluster-wide, and it\r\n            # outlives a broken node agent (unlike the agent's local API proxy, never used here)\r\n            KUBEPROXY_KUBECONFIG=/var/lib/rancher/k3s/agent/kubeproxy.kubeconfig\r\n            # The node agent's load-balancer state: every control-plane server it knows\r\n            AGENT_LB_DIR=/var/lib/rancher/k3s/agent/etc\r\n            LIVEKIT_POD_LABEL=app.kubernetes.io/component=ov-livekit-server\r\n            REDIS_SERVICES=\"redis,redis-sentinel,redis-headless\"\r\n            \r\n            log() { echo \"[media-health] $*\"; }\r\n            \r\n            # Seconds since boot: monotonic, unaffected by clock steps\r\n            uptime_sec() { cut -d. -f1 /proc/uptime; }\r\n            \r\n            # Busy CPU percentage since the previous call, in BUSY (0 on the first call)\r\n            cpu_busy() {\r\n                read -r _ c_user c_nice c_system c_idle c_iowait c_irq c_softirq c_steal _ < /proc/stat\r\n                total=$((c_user + c_nice + c_system + c_idle + c_iowait + c_irq + c_softirq + c_steal))\r\n                idle=$((c_idle + c_iowait))\r\n                BUSY=0\r\n                if [ -n \"$PREV_TOTAL\" ] && [ \"$total\" -gt \"$PREV_TOTAL\" ]; then\r\n                    BUSY=$((100 * (total - PREV_TOTAL - idle + PREV_IDLE) / (total - PREV_TOTAL)))\r\n                fi\r\n                PREV_TOTAL=$total\r\n                PREV_IDLE=$idle\r\n            }\r\n            \r\n            # The ready LiveKit pod on this node, from the container runtime: its creation time\r\n            # (epoch seconds) in LIVEKIT_CREATED and its namespace in LIVEKIT_NS, both empty when\r\n            # there is none. A pod, not a container: a container restarting inside it is no warm-up.\r\n            livekit_pod() {\r\n                LIVEKIT_CREATED=\"\"\r\n                LIVEKIT_NS=\"\"\r\n                pods=$(timeout 20 k3s crictl pods --label \"$LIVEKIT_POD_LABEL\" --state ready -o json 2>/dev/null) || return\r\n                LIVEKIT_NS=$(printf '%s' \"$pods\" | jq -r '[.items[].metadata.namespace] | first // empty' 2>/dev/null)\r\n                LIVEKIT_CREATED=$(printf '%s' \"$pods\" | jq -r '[.items[].createdAt | tonumber] | if length == 0 then empty else (max / 1000000000 | floor) end' 2>/dev/null)\r\n                case \"$LIVEKIT_CREATED\" in *[!0-9]*) LIVEKIT_CREATED=\"\" ;; esac\r\n            }\r\n            \r\n            # The LiveKit pod was created, or this node joined, less than WARMUP_SEC ago (a node\r\n            # without a ready LiveKit pod gets no warm-up of its own: nothing on it is starting)\r\n            livekit_starting() {\r\n                now=$(date +%s)\r\n                if [ -n \"$LIVEKIT_CREATED\" ] && [ $((now - LIVEKIT_CREATED)) -lt \"$WARMUP_SEC\" ]; then\r\n                    return 0\r\n                fi\r\n                joined=$(head -c 20 \"$INSTALLED_MARKER\" 2>/dev/null)\r\n                case \"$joined\" in ''|*[!0-9]*) return 1 ;; esac\r\n                [ $((now - joined)) -lt \"$WARMUP_SEC\" ]\r\n            }\r\n            \r\n            # Control-plane servers (host:port) this node can ask directly: every server its node\r\n            # agent knows, and CONTROL_PLANE, the one it joined through\r\n            control_plane_servers() {\r\n                for f in \"$AGENT_LB_DIR\"/*load-balancer.json; do\r\n                    [ -f \"$f\" ] && jq -r '(.ServerAddresses // [])[], (.ServerURL // empty | sub(\"^https://\"; \"\"))' \"$f\" 2>/dev/null\r\n                done\r\n                [ -n \"$CONTROL_PLANE\" ] && echo \"$CONTROL_PLANE\"\r\n            }\r\n            \r\n            # The cluster serves: a control-plane server answers and, through it, at least one of the\r\n            # Redis endpoints LiveKit needs is serving. A bare API answer would not do: Redis down\r\n            # alone also fails the health check of every Media Node at once. Serving, not ready: the\r\n            # headless Service of HA publishes its not-ready addresses as ready.\r\n            cluster_serving() {\r\n                [ -f \"$KUBEPROXY_KUBECONFIG\" ] || return 1\r\n                scope=\"--all-namespaces\"\r\n                [ -n \"$LIVEKIT_NS\" ] && scope=\"--namespace=$LIVEKIT_NS\"\r\n                for server in $(control_plane_servers | sort -u); do\r\n                    serving=$(timeout 20 k3s kubectl --kubeconfig \"$KUBEPROXY_KUBECONFIG\" --server \"https://$server\" \\\r\n                            --request-timeout=10s get endpointslices \"$scope\" \\\r\n                            -l \"kubernetes.io/service-name in ($REDIS_SERVICES)\" -o json 2>/dev/null \\\r\n                        | jq '[.items[].endpoints[]? | select((.conditions | if has(\"serving\") then .serving else .ready end) == true)] | length' 2>/dev/null)\r\n                    case \"$serving\" in ''|*[!0-9]*) continue ;; esac\r\n                    [ \"$serving\" -gt 0 ]\r\n                    return\r\n                done\r\n                return 1\r\n            }\r\n            \r\n            # Request the replacement of this node ($1 = reason). Gated on the cluster serving once\r\n            # the node has joined; a node that never joined has nothing to wait for.\r\n            request_replacement() {\r\n                now=$(uptime_sec)\r\n                if [ -n \"$REQUESTED_AT\" ] && [ $((now - REQUESTED_AT)) -lt \"$REPLACE_RETRY_SEC\" ]; then\r\n                    return\r\n                fi\r\n                if [ -f \"$INSTALLED_MARKER\" ] && ! cluster_serving; then\r\n                    if [ -z \"$HOLD_LOGGED_AT\" ] || [ $((now - HOLD_LOGGED_AT)) -ge 600 ]; then\r\n                        log \"$1, but the cluster does not serve (no control-plane server or Redis endpoint answers): not replacing this node\"\r\n                        HOLD_LOGGED_AT=$now\r\n                    fi\r\n                    return\r\n                fi\r\n                log \"$1: requesting the replacement of this node\"\r\n                if \"$REPLACE_SCRIPT\" \"$1\"; then\r\n                    REQUESTED_AT=$now\r\n                    log \"replacement requested\"\r\n                else\r\n                    log \"the replacement request failed, retrying in $INTERVAL_SEC s\"\r\n                fi\r\n            }\r\n            \r\n            mkdir -p \"$STATE_DIR\"\r\n            REQUESTED_AT=\"\"\r\n            HOLD_LOGGED_AT=\"\"\r\n            FAILED_SEEN_AT=\"\"\r\n            FAIL_SINCE=\"\"\r\n            SATURATED=\"\"\r\n            PREV_TOTAL=\"\"\r\n            PREV_IDLE=\"\"\r\n            log \"started\"\r\n            \r\n            while true; do\r\n                PROBE_URL=http://127.0.0.1:7780/\r\n                INTERVAL_SEC=30\r\n                HARD_UNHEALTHY_AFTER_SEC=300\r\n                SOFT_UNHEALTHY_AFTER_SEC=600\r\n                CPU_SATURATED_PCT=90\r\n                WARMUP_SEC=900\r\n                BOOTSTRAP_DEADLINE_SEC=5400\r\n                BOOTSTRAP_FAILURE_COOLDOWN_SEC=600\r\n                REPLACE_RETRY_SEC=600\r\n                CONTROL_PLANE=\"\"\r\n                [ -f \"$ENV_FILE\" ] && . \"$ENV_FILE\"\r\n                NOW=$(uptime_sec)\r\n                cpu_busy\r\n            \r\n                if [ -f \"$PAUSE_FILE\" ] || [ -f \"$DRAIN_PAUSE_FILE\" ]; then\r\n                    FAIL_SINCE=\"\"\r\n                elif [ -f \"$BOOTSTRAP_FAILED_MARKER\" ]; then\r\n                    if [ -z \"$FAILED_SEEN_AT\" ]; then\r\n                        FAILED_SEEN_AT=$NOW\r\n                        log \"bootstrap failed ($(head -c 300 \"$BOOTSTRAP_FAILED_MARKER\")): replacing this node in $BOOTSTRAP_FAILURE_COOLDOWN_SEC s\"\r\n                    fi\r\n                    if [ $((NOW - FAILED_SEEN_AT)) -ge \"$BOOTSTRAP_FAILURE_COOLDOWN_SEC\" ]; then\r\n                        request_replacement \"bootstrap failed: $(head -c 300 \"$BOOTSTRAP_FAILED_MARKER\")\"\r\n                    fi\r\n                elif [ ! -f \"$INSTALLED_MARKER\" ]; then\r\n                    if [ \"$NOW\" -ge \"$BOOTSTRAP_DEADLINE_SEC\" ]; then\r\n                        request_replacement \"bootstrap not finished $BOOTSTRAP_DEADLINE_SEC s after boot\"\r\n                    fi\r\n                elif curl -sf -o /dev/null --connect-timeout 3 --max-time 15 \"$PROBE_URL\"; then\r\n                    [ -n \"$FAIL_SINCE\" ] && log \"LiveKit healthy again after $((NOW - FAIL_SINCE)) s\"\r\n                    FAIL_SINCE=\"\"\r\n                    SATURATED=\"\"\r\n                else\r\n                    RC=$?\r\n                    case \"$RC\" in\r\n                        7|52|56) KIND=hard ;;\r\n                        *) KIND=soft ;;\r\n                    esac\r\n                    livekit_pod\r\n                    if livekit_starting; then\r\n                        FAIL_SINCE=\"\"\r\n                    elif ! cluster_serving; then\r\n                        # A control-plane or Redis outage fails the health check of every Media Node at\r\n                        # once: not counted, so LiveKit gets the whole window once the cluster serves again\r\n                        FAIL_SINCE=\"\"\r\n                        if [ -z \"$HOLD_LOGGED_AT\" ] || [ $((NOW - HOLD_LOGGED_AT)) -ge 600 ]; then\r\n                            log \"LiveKit health check failed (curl exit $RC), but the cluster does not serve: not counted\"\r\n                            HOLD_LOGGED_AT=$NOW\r\n                        fi\r\n                    elif [ \"$KIND\" = soft ] && [ \"$BUSY\" -ge \"$CPU_SATURATED_PCT\" ]; then\r\n                        [ -n \"$SATURATED\" ] || log \"LiveKit not ready (curl exit $RC) with the CPU $BUSY% busy: not counted\"\r\n                        SATURATED=1\r\n                        FAIL_SINCE=\"\"\r\n                    else\r\n                        SATURATED=\"\"\r\n                        if [ -z \"$FAIL_SINCE\" ]; then\r\n                            FAIL_SINCE=$NOW\r\n                            log \"LiveKit health check failed (curl exit $RC)\"\r\n                        fi\r\n                        LIMIT=$SOFT_UNHEALTHY_AFTER_SEC\r\n                        [ \"$KIND\" = hard ] && LIMIT=$HARD_UNHEALTHY_AFTER_SEC\r\n                        if [ $((NOW - FAIL_SINCE)) -ge \"$LIMIT\" ]; then\r\n                            request_replacement \"LiveKit unhealthy for $((NOW - FAIL_SINCE)) s (curl exit $RC)\"\r\n                        fi\r\n                    fi\r\n                fi\r\n                sleep \"$INTERVAL_SEC\"\r\n            done\r\n            \r\n            HEALTH_EOF\r\n            cat > /usr/local/bin/openvidu-media-leave.sh << 'HEALTH_EOF'\r\n            #!/bin/bash\r\n            # openvidu-media-leave.sh mark|unmark|stop\r\n            # How an unhealthy Media Node leaves the cluster while the cloud replaces it, used by\r\n            # openvidu-media-replace.sh around its request:\r\n            #   mark    before it: /run/openvidu-unhealthy (the scale-in path then does not wait for\r\n            #           sessions) and this Node labelled openvidu.io/scale-in=left: its session\r\n            #           workloads leave it, and once it stops answering ov-scale-in-cleanup deletes it,\r\n            #           so a replacement that comes back under the same name can join\r\n            #   unmark  the request failed: both undone (the label back to the one the node had), the\r\n            #           node stays a member\r\n            #   stop    the request was accepted: the node agent stops, so the Node stops answering\r\n            # Every step is best effort: a node that never joined has no Node to label.\r\n            #\r\n            # This file is embedded verbatim in CloudFormation !Sub blocks, Bicep strings and Terraform\r\n            # heredocs, so it must never contain a dollar sign or a percent sign followed by an opening\r\n            # brace, nor two opening braces in a row.\r\n            \r\n            KUBELET_KUBECONFIG=/var/lib/rancher/k3s/agent/kubelet.kubeconfig\r\n            AGENT_LB_DIR=/var/lib/rancher/k3s/agent/etc\r\n            ENV_FILE=/etc/openvidu/media-health.env\r\n            SCALE_IN_LABEL=openvidu.io/scale-in\r\n            PREV_LABEL_FILE=/run/openvidu-media-health.scale-in-label\r\n            \r\n            # Control-plane servers (host:port) this node can ask directly: every server its node\r\n            # agent knows, and CONTROL_PLANE, the one it joined through\r\n            control_plane_servers() {\r\n                for f in \"$AGENT_LB_DIR\"/*load-balancer.json; do\r\n                    [ -f \"$f\" ] && jq -r '(.ServerAddresses // [])[], (.ServerURL // empty | sub(\"^https://\"; \"\"))' \"$f\" 2>/dev/null\r\n                done\r\n                [ -n \"$CONTROL_PLANE\" ] && echo \"$CONTROL_PLANE\"\r\n            }\r\n            \r\n            # kubectl with the node agent's own credential (system:node:<name>), which may label its\r\n            # Node, straight to a control-plane server: the agent's local API proxy is down with a\r\n            # broken agent, which is a node being replaced\r\n            kubelet_kubectl() {\r\n                [ -f \"$KUBELET_KUBECONFIG\" ] || return 1\r\n                CONTROL_PLANE=\"\"\r\n                [ -f \"$ENV_FILE\" ] && . \"$ENV_FILE\"\r\n                for server in $(control_plane_servers | sort -u); do\r\n                    timeout 30 k3s kubectl --kubeconfig \"$KUBELET_KUBECONFIG\" --server \"https://$server\" \\\r\n                        --request-timeout=10s \"$@\" && return 0\r\n                done\r\n                return 1\r\n            }\r\n            \r\n            # This node's name, from its credential, as `ov stack leave` finds it\r\n            node_name() {\r\n                user=$(kubelet_kubectl auth whoami -o jsonpath='{.status.userInfo.username}' 2>/dev/null) || return 1\r\n                case \"$user\" in\r\n                    system:node:?*) echo \"$user\" | cut -d: -f3 ;;\r\n                    *) return 1 ;;\r\n                esac\r\n            }\r\n            \r\n            case \"$1\" in\r\n                mark)\r\n                    touch /run/openvidu-unhealthy\r\n                    if NODE=$(node_name); then\r\n                        # The label it had (a scale-in labels it draining), put back if the request fails\r\n                        kubelet_kubectl get node \"$NODE\" -o jsonpath='{.metadata.labels.openvidu\\.io/scale-in}' > \"$PREV_LABEL_FILE\" 2>/dev/null\r\n                        kubelet_kubectl label node \"$NODE\" \"$SCALE_IN_LABEL=left\" --overwrite >/dev/null 2>&1\r\n                    fi\r\n                    ;;\r\n                unmark)\r\n                    rm -f /run/openvidu-unhealthy\r\n                    # Only the label mark set is undone, back to the one the node had\r\n                    if NODE=$(node_name); then\r\n                        prev=$(cat \"$PREV_LABEL_FILE\" 2>/dev/null)\r\n                        value=$(kubelet_kubectl get node \"$NODE\" -o jsonpath='{.metadata.labels.openvidu\\.io/scale-in}' 2>/dev/null)\r\n                        if [ \"$value\" = left ] && [ -n \"$prev\" ] && [ \"$prev\" != left ]; then\r\n                            kubelet_kubectl label node \"$NODE\" \"$SCALE_IN_LABEL=$prev\" --overwrite >/dev/null 2>&1\r\n                        elif [ \"$value\" = left ]; then\r\n                            kubelet_kubectl label node \"$NODE\" \"$SCALE_IN_LABEL-\" >/dev/null 2>&1\r\n                        fi\r\n                    fi\r\n                    rm -f \"$PREV_LABEL_FILE\"\r\n                    ;;\r\n                stop)\r\n                    systemctl stop k3s-agent 2>/dev/null\r\n                    ;;\r\n            esac\r\n            exit 0\r\n            \r\n            HEALTH_EOF\r\n            cat > /usr/local/bin/openvidu-media-replace.sh << 'HEALTH_EOF'\r\n            #!/bin/bash\r\n            # openvidu-media-replace.sh \"<reason>\"\r\n            # Asks the regional MIG to recreate THIS Media Node (delete + create in place: same name,\r\n            # new instance, fresh disk), which keeps the number of Media Nodes. Called by the health\r\n            # watchdog (same cgroup): it never stops or signals it.\r\n            export HOME=/root\r\n            mkdir -p /var/lib/openvidu-media-health\r\n            echo \"$(date -u +%FT%TZ) $1\" >> /var/lib/openvidu-media-health/replace-requests.log\r\n            /usr/local/bin/openvidu-media-leave.sh mark\r\n            # Undone if the request fails: the node then stays, and if it recovers a later scale-in\r\n            # must still wait for its sessions\r\n            trap '[ $? -eq 0 ] || /usr/local/bin/openvidu-media-leave.sh unmark' EXIT\r\n            \r\n            INSTANCE_NAME=$(curl -sf -H \"Metadata-Flavor: Google\" \"http://metadata.google.internal/computeMetadata/v1/instance/name\")\r\n            if [ -z \"$INSTANCE_NAME\" ]; then\r\n              echo \"[openvidu-media-replace] could not read this instance name from the metadata\" >&2\r\n              exit 1\r\n            fi\r\n            # Retries transient API errors. \"Not a member / already being deleted, abandoned or\r\n            # recreated\" means the node is already leaving the group (scaled in: its watcher then\r\n            # leaves without waiting for sessions): nothing to do.\r\n            for attempt in 1 2 3 4 5; do\r\n              if OUT=$(gcloud compute instance-groups managed recreate-instances \"openvidu-e2e-gcp-el-s113145-media-node-group\" \\\r\n                  --instances=\"$INSTANCE_NAME\" --region=\"europe-west2\" --project=\"***\" --quiet 2>&1); then\r\n                /usr/local/bin/openvidu-media-leave.sh stop\r\n                exit 0\r\n              fi\r\n              case \"$OUT\" in\r\n                *\"not a member\"*|*\"being deleted\"*|*\"being recreated\"*|*abandon*|*ABANDON*)\r\n                  echo \"[openvidu-media-replace] $INSTANCE_NAME is already leaving the group: $OUT\" >&2\r\n                  exit 0\r\n                  ;;\r\n              esac\r\n              echo \"[openvidu-media-replace] recreate failed (attempt $attempt/5): $OUT\" >&2\r\n              sleep 12\r\n            done\r\n            exit 1\r\n            \r\n            HEALTH_EOF\r\n            chmod 0755 /usr/local/bin/openvidu-media-health.sh /usr/local/bin/openvidu-media-leave.sh /usr/local/bin/openvidu-media-replace.sh\r\n            cat > /etc/systemd/system/openvidu-media-health.service << 'HEALTH_EOF'\r\n            [Unit]\r\n            Description=OpenVidu Media Node health watchdog\r\n            After=network-online.target\r\n            Wants=network-online.target\r\n            \r\n            [Service]\r\n            Type=simple\r\n            ExecStart=/usr/local/bin/openvidu-media-health.sh\r\n            Restart=always\r\n            RestartSec=30\r\n            \r\n            [Install]\r\n            WantedBy=multi-user.target\r\n            HEALTH_EOF\r\n            systemctl daemon-reload\r\n            if [ \"instance\" != client ]; then\r\n              systemctl enable --now openvidu-media-health.service\r\n            fi\r\n            # From here on, a bootstrap that stops on an error is marked failed for the watchdog\r\n            trap 'rc=$?; if [ \"$rc\" -ne 0 ] && [ ! -f /var/lib/openvidu-media-health/installed ]; then echo \"media node bootstrap exited with code $rc\" > /var/lib/openvidu-media-health/bootstrap-failed; fi' EXIT\r\n            \r\n            # ---- Join the cluster ----\r\n            # BY DESIGN, not provisionally: a media node only joins. The OpenVidu CLI deploys\r\n            # the MASTER; this node enrols itself with the published join credentials —\r\n            # `ov stack join` puts the node agent on it, tunes the kernel and labels it\r\n            # ov-node-role=medianode — and the chart's media DaemonSets schedule onto it by that\r\n            # label. Scaling in/out is the group's business, never a deploy's.\r\n            #\r\n            # The join credentials are read from Secret Manager with this node's own service\r\n            # account — which may read those two secrets and nothing else — so they are never in\r\n            # the instance template and rotating them costs nothing. Retried for 30 minutes:\r\n            # `terraform apply` returns as soon as the machines exist, so this node usually\r\n            # boots while the master is still deploying. In a deployedBy=client stack they\r\n            # appear only when your own deploy brings the cluster up — which may be long after\r\n            # this window, or never — which is why the timeout leaves the node UP and unjoined\r\n            # instead of failing it.\r\n            join_secret() { gcloud secrets versions access latest --secret=\"openvidu-e2e-gcp-el-s113145-$1\" --project=\"***\" 2>/dev/null || true; }\r\n            JOINABLE=\"\"\r\n            # xtrace off: the next lines carry secrets.\r\n            { set +x; } 2>/dev/null\r\n            for i in $(seq 1 180); do\r\n              OPENVIDU_JOIN_ADDRESS=\"$(join_secret OPENVIDU_JOIN_ADDRESS)\"\r\n              OPENVIDU_JOIN_TOKEN=\"$(join_secret OPENVIDU_JOIN_TOKEN)\"\r\n              if [ -n \"$OPENVIDU_JOIN_ADDRESS\" ] && [ -n \"$OPENVIDU_JOIN_TOKEN\" ]; then\r\n                JOINABLE=1; break\r\n              fi\r\n              echo \"[media] the cluster has not published its join credentials yet ($i/180)\"\r\n              sleep 10\r\n            done\r\n            set -x\r\n            if [ -z \"$JOINABLE\" ]; then\r\n              echo \"[media] no join credentials after 30 minutes — this node stays up, unjoined\"\r\n              exit 0\r\n            fi\r\n            \r\n            # ---- OpenVidu CLI ----\r\n            # The same binary master-1 runs, verified the same way: it carries the node agent\r\n            # this machine needs to join, so nothing else is fetched.\r\n            OPENVIDU_VERSION=\"ov-admin\"\r\n            CLI_BASE=\"https://get.openvidu.io/cli\"\r\n            ARCH=\"$(dpkg --print-architecture)\"\r\n            CLI=\"ov_linux_${ARCH}.gz\"\r\n            curl -fsSL \"$CLI_BASE/$OPENVIDU_VERSION/${CLI}\" -o \"/tmp/${CLI}\"\r\n            if curl -fsSL \"$CLI_BASE/$OPENVIDU_VERSION/SHA256SUMS\" -o /tmp/SHA256SUMS; then\r\n              (cd /tmp && grep -E \"^[0-9a-f]+  ${CLI}$\" SHA256SUMS | sha256sum -c -)\r\n            else\r\n              echo \"[join] WARNING: no SHA256SUMS published for $OPENVIDU_VERSION — binary not verified\"\r\n            fi\r\n            gunzip -c \"/tmp/${CLI}\" > /usr/local/bin/ov && chmod 0755 /usr/local/bin/ov\r\n            rm -f \"/tmp/${CLI}\" /tmp/SHA256SUMS\r\n            \r\n            export OPENVIDU_JOIN_ADDRESS OPENVIDU_JOIN_TOKEN\r\n            /usr/local/bin/ov stack join --this-node --as media\r\n            # Joined: the watchdog watches LiveKit from now on, and asks the server this node joined\r\n            # through (besides those its node agent knows) whether the cluster serves\r\n            CONTROL_PLANE=$(printf '%s' \"$OPENVIDU_JOIN_ADDRESS\" | sed -e 's#^[a-z]*://##' -e 's#/.*$##')\r\n            case \"$CONTROL_PLANE\" in *:*) ;; *) CONTROL_PLANE=\"$CONTROL_PLANE:6443\" ;; esac\r\n            echo \"CONTROL_PLANE=$CONTROL_PLANE\" > /etc/openvidu/media-health.env\r\n            date +%s > /var/lib/openvidu-media-health/installed\r\n            \r\n            # ---- Arm the scale-in watcher ----\r\n            # gcloud and ov are both on this node now (gcloud reads the join secrets, ov just joined),\r\n            # so the watcher has everything it needs. It reacts to the MIG, not to the cluster, so it is\r\n            # enabled whether or not the join above succeeded: an abandoned node must still drain and\r\n            # self-delete even if it never became a working member.\r\n            cat > /usr/local/bin/openvidu-scalein-watch.sh << 'SCALEIN_WATCH_EOF'\r\n            #!/bin/bash\r\n            # OpenVidu media node scale-in watcher (GCP).\r\n            set -u\r\n            export HOME=/root\r\n            log() { echo \"[openvidu-scalein-watch $(date -u '+%Y-%m-%dT%H:%M:%SZ')] $*\"; }\r\n            \r\n            meta() { curl -sf -H \"Metadata-Flavor: Google\" \"http://metadata.google.internal/computeMetadata/v1/$1\"; }\r\n            INSTANCE_NAME=\"$(meta instance/name)\"\r\n            ZONE=\"$(meta instance/zone | cut -d/ -f4)\"\r\n            PROJECT_ID=\"***\"\r\n            REGION=\"europe-west2\"\r\n            MIG_NAME=\"openvidu-e2e-gcp-el-s113145-media-node-group\"\r\n            log \"started: instance=$INSTANCE_NAME zone=$ZONE mig=$MIG_NAME\"\r\n            \r\n            in_mig() {\r\n              gcloud compute instance-groups managed list-instances \"$MIG_NAME\" \\\r\n                --region=\"$REGION\" --project=\"$PROJECT_ID\" \\\r\n                --format=\"value(instance.basename())\" 2>/dev/null | grep -Fxq \"$INSTANCE_NAME\"\r\n            }\r\n            \r\n            # Poll MIG membership every 30 s. When this instance is no longer listed, the Function has\r\n            # abandoned it for scale-in. A missing name can also be a transient API error, so confirm\r\n            # once more before acting.\r\n            while true; do\r\n              if ! in_mig; then\r\n                sleep 15\r\n                if ! in_mig; then\r\n                  log \"no longer a MIG member — this node was abandoned for scale-in.\"\r\n                  break\r\n                fi\r\n              fi\r\n              sleep 30\r\n            done\r\n            \r\n            # A lock so a restarted watcher never drains twice.\r\n            exec 9>/var/lock/openvidu-scalein.lock\r\n            if ! flock -n 9; then\r\n              log \"a drain is already in progress; nothing to do.\"\r\n              exit 0\r\n            fi\r\n            \r\n            # DRAIN with NO time limit: `ov stack leave --drain` stops new rooms landing here and waits\r\n            # until the rooms, recordings and ingests this node holds have ended (it can take hours or\r\n            # days), then --uninstall removes the node agent. The retries only cover the case where the\r\n            # node never became a working member (nothing to protect), so it goes anyway rather than\r\n            # stay up, billed, forever.\r\n            # The health watchdog stops first: a node that drains on purpose is never also replaced.\r\n            # A node it is replacing has no sessions worth waiting for.\r\n            touch /run/openvidu-media-health.paused\r\n            systemctl stop openvidu-media-health 2>/dev/null || true\r\n            LEAVE_FLAGS=\"--drain --uninstall\"\r\n            if [ -f /run/openvidu-unhealthy ]; then\r\n              log \"unhealthy and being replaced: leaving without waiting for sessions.\"\r\n              LEAVE_FLAGS=\"--uninstall\"\r\n            fi\r\n            log \"draining, then leaving the cluster.\"\r\n            for try in 1 2 3 4 5; do\r\n              /usr/local/bin/ov stack leave --this-node $LEAVE_FLAGS && break\r\n              log \"leaving the cluster failed (try $try/5); retrying in 60 s.\"\r\n              sleep 60\r\n            done\r\n            \r\n            # Only now, with the sessions finished, delete the VM — the last billable resource for this\r\n            # node. It is already outside the MIG, so this is a plain instance delete.\r\n            log \"drained; deleting this VM.\"\r\n            gcloud compute instances delete \"$INSTANCE_NAME\" --zone=\"$ZONE\" --project=\"$PROJECT_ID\" --quiet \\\r\n              || log \"self-delete failed; the VM may already be terminating.\"\r\n            log \"done.\"\r\n            \r\n            SCALEIN_WATCH_EOF\r\n            chmod 0755 /usr/local/bin/openvidu-scalein-watch.sh\r\n            \r\n            cat > /etc/systemd/system/openvidu-scalein-watch.service << 'SCALEIN_SVC_EOF'\r\n            [Unit]\r\n            Description=OpenVidu media node scale-in watcher\r\n            After=network-online.target\r\n            Wants=network-online.target\r\n            \r\n            [Service]\r\n            Type=simple\r\n            ExecStart=/usr/local/bin/openvidu-scalein-watch.sh\r\n            Restart=on-failure\r\n            RestartSec=30\r\n            StandardOutput=append:/var/log/openvidu-scalein-watch.log\r\n            StandardError=append:/var/log/openvidu-scalein-watch.log\r\n            \r\n            [Install]\r\n            WantedBy=multi-user.target\r\n            SCALEIN_SVC_EOF\r\n            \r\n            systemctl daemon-reload\r\n            systemctl enable --now openvidu-scalein-watch.service\r\n            \r\n            touch /opt/openvidu/.bootstrap-complete\r\n        EOT\r\n      + name                    = (known after apply)\r\n      + name_prefix             = \"openvidu-e2e-gcp-el-s113-media-node-\"\r\n      + numeric_id              = (known after apply)\r\n      + project                 = \"***\"\r\n      + region                  = (known after apply)\r\n      + self_link               = (known after apply)\r\n      + self_link_unique        = (known after apply)\r\n      + tags                    = [\r\n          + \"openvidu-e2e-gcp-el-s113145-media-node\",\r\n        ]\r\n      + tags_fingerprint        = (known after apply)\r\n      + terraform_labels        = {\r\n          + \"goog-terraform-provisioned\" = \"true\"\r\n          + \"node-type\"                  = \"media\"\r\n          + \"stack\"                      = \"openvidu-e2e-gcp-el-s113145\"\r\n        }\r\n\r\n      + confidential_instance_config (known after apply)\r\n\r\n      + disk {\r\n"]
[21.098,"o","          + architecture           = (known after apply)\r\n          + auto_delete            = true\r\n          + boot                   = true\r\n          + device_name            = (known after apply)\r\n          + disk_size_gb           = 200\r\n          + disk_type              = \"pd-balanced\"\r\n          + interface              = (known after apply)\r\n          + mode                   = (known after apply)\r\n          + provisioned_iops       = (known after apply)\r\n          + provisioned_throughput = (known after apply)\r\n          + source_image           = \"ubuntu-os-cloud/ubuntu-2404-lts-amd64\"\r\n          + type                   = (known after apply)\r\n        }\r\n\r\n      + network_interface {\r\n          + igmp_query                  = (known after apply)\r\n          + internal_ipv6_prefix_length = (known after apply)\r\n          + ipv6_access_type            = (known after apply)\r\n          + ipv6_address                = (known after apply)\r\n          + name                        = (known after apply)\r\n          + network                     = \"default\"\r\n          + network_attachment          = (known after apply)\r\n          + parent_nic_name             = (known after apply)\r\n          + stack_type                  = (known after apply)\r\n          + subnetwork                  = (known after apply)\r\n          + subnetwork_project          = (known after apply)\r\n\r\n          + access_config {\r\n              + nat_ip                 = (known after apply)\r\n              + network_tier           = (known after apply)\r\n              + public_ptr_domain_name = (known after apply)\r\n            }\r\n        }\r\n\r\n      + scheduling (known after apply)\r\n\r\n      + service_account {\r\n          + email  = \"openvidu-e2e-g-5f1629-media-sa@***.iam.gserviceaccount.com\"\r\n          + scopes = [\r\n              + \"https://www.googleapis.com/auth/cloud-platform\",\r\n            ]\r\n        }\r\n    }\r\n\r\n  # google_compute_region_health_check.media_node will be created\r\n  + resource \"google_compute_region_health_check\" \"media_node\" {\r\n      + check_interval_sec  = 150\r\n      + creation_timestamp  = (known after apply)\r\n      + deletion_policy     = \"DELETE\"\r\n      + health_check_id     = (known after apply)\r\n      + healthy_threshold   = 2\r\n      + id                  = (known after apply)\r\n      + name                = \"openvidu-e2e-gcp-el-s113145-media-node-health-check\"\r\n      + project             = \"***\"\r\n      + region              = \"europe-west2\"\r\n      + self_link           = (known after apply)\r\n      + timeout_sec         = 10\r\n      + type                = (known after apply)\r\n      + unhealthy_threshold = 10\r\n\r\n      + log_config (known after apply)\r\n\r\n      + tcp_health_check {\r\n          + port         = 7780\r\n          + proxy_header = \"NONE\"\r\n        }\r\n    }\r\n\r\n  # google_compute_region_instance_group_manager.media_node_group will be created\r\n  + resource \"google_compute_region_instance_group_manager\" \"media_node_group\" {\r\n      + base_instance_name               = \"openvidu-e2e-gcp-el-s113145-media-node\"\r\n      + creation_timestamp               = (known after apply)\r\n      + deletion_policy                  = \"DELETE\"\r\n      + distribution_policy_target_shape = (known after apply)\r\n      + distribution_policy_zones        = (known after apply)\r\n      + fingerprint                      = (known after apply)\r\n      + id                               = (known after apply)\r\n      + instance_group                   = (known after apply)\r\n      + instance_group_manager_id        = (known after apply)\r\n      + list_managed_instances_results   = \"PAGELESS\"\r\n      + name                             = \"openvidu-e2e-gcp-el-s113145-media-node-group\"\r\n      + project                          = \"***\"\r\n      + region                           = \"europe-west2\"\r\n      + self_link                        = (known after apply)\r\n      + status                           = (known after apply)\r\n      + target_size                      = 1\r\n      + target_stopped_size              = (known after apply)\r\n      + target_suspended_size            = (known after apply)\r\n      + wait_for_instances               = false\r\n      + wait_for_instances_status        = \"STABLE\"\r\n\r\n      + auto_healing_policies {\r\n          + health_check      = (known after apply)\r\n          + initial_delay_sec = 900\r\n        }\r\n\r\n      + instance_lifecycle_policy (known after apply)\r\n\r\n      + standby_policy (known after apply)\r\n\r\n      + target_size_policy (known after apply)\r\n\r\n      + update_policy (known after apply)\r\n\r\n      + version {\r\n          + instance_template = (known after apply)\r\n        }\r\n    }\r\n\r\n  # google_project_iam_member.media_node_compute will be created\r\n  + resource \"google_project_iam_member\" \"media_node_compute\" {\r\n      + etag    = (known after apply)\r\n      + id      = (known after apply)\r\n      + member  = \"serviceAccount:openvidu-e2e-g-5f1629-media-sa@***.iam.gserviceaccount.com\"\r\n      + project = \"***\"\r\n      + role    = \"roles/compute.instanceAdmin.v1\"\r\n    }\r\n\r\n  # google_project_iam_member.scalein_compute will be created\r\n  + resource \"google_project_iam_member\" \"scalein_compute\" {\r\n      + etag    = (known after apply)\r\n      + id      = (known after apply)\r\n      + member  = \"serviceAccount:openvidu-e2e-5f1629-scalein-sa@***.iam.gserviceaccount.com\"\r\n      + project = \"***\"\r\n      + role    = \"roles/compute.instanceAdmin.v1\"\r\n    }\r\n\r\n  # google_project_service.cloudbuild_api will be created\r\n  + resource \"google_project_service\" \"cloudbuild_api\" {\r\n      + deletion_policy    = \"DELETE\"\r\n      + disable_on_destroy = false\r\n      + id                 = (known after apply)\r\n      + project            = \"***\"\r\n      + service            = \"cloudbuild.googleapis.com\"\r\n    }\r\n\r\n  # google_project_service.cloudfunctions_api will be created\r\n  + resource \"google_project_service\" \"cloudfunctions_api\" {\r\n      + deletion_policy    = \"DELETE\"\r\n      + disable_on_destroy = false\r\n      + id                 = (known after apply)\r\n      + project            = \"***\"\r\n      + service            = \"cloudfunctions.googleapis.com\"\r\n    }\r\n\r\n  # google_project_service.cloudresourcemanager_api will be created\r\n  + resource \"google_project_service\" \"cloudresourcemanager_api\" {\r\n      + deletion_policy    = \"DELETE\"\r\n      + disable_on_destroy = false\r\n      + id                 = (known after apply)\r\n      + project            = \"***\"\r\n      + service            = \"cloudresourcemanager.googleapis.com\"\r\n    }\r\n\r\n  # google_project_service.cloudscheduler_api will be created\r\n  + resource \"google_project_service\" \"cloudscheduler_api\" {\r\n      + deletion_policy    = \"DELETE\"\r\n      + disable_on_destroy = false\r\n      + id                 = (known after apply)\r\n      + project            = \"***\"\r\n      + service            = \"cloudscheduler.googleapis.com\"\r\n    }\r\n\r\n  # google_project_service.compute_api will be created\r\n  + resource \"google_project_service\" \"compute_api\" {\r\n      + deletion_policy    = \"DELETE\"\r\n      + disable_on_destroy = false\r\n      + id                 = (known after apply)\r\n      + project            = \"***\"\r\n      + service            = \"compute.googleapis.com\"\r\n    }\r\n\r\n  # google_project_service.iam_api will be created\r\n  + resource \"google_project_service\" \"iam_api\" {\r\n      + deletion_policy    = \"DELETE\"\r\n      + disable_on_destroy = false\r\n      + id                 = (known after apply)\r\n      + project            = \"***\"\r\n      + service            = \"iam.googleapis.com\"\r\n    }\r\n\r\n  # google_project_service.run_api will be created\r\n  + resource \"google_project_service\" \"run_api\" {\r\n      + deletion_policy    = \"DELETE\"\r\n      + disable_on_destroy = false\r\n      + id                 = (known after apply)\r\n      + project            = \"***\"\r\n      + service            = \"run.googleapis.com\"\r\n    }\r\n\r\n  # google_project_service.secretmanager_api will be created\r\n  + resource \"google_project_service\" \"secretmanager_api\" {\r\n      + deletion_policy    = \"DELETE\"\r\n      + disable_on_destroy = false\r\n      + id                 = (known after apply)\r\n      + project            = \"***\"\r\n      + service            = \"secretmanager.googleapis.com\"\r\n    }\r\n\r\n  # google_project_service.storage_api will be created\r\n  + resource \"google_project_service\" \"storage_api\" {\r\n      + deletion_policy    = \"DELETE\"\r\n      + disable_on_destroy = false\r\n      + id                 = (known after apply)\r\n      + project            = \"***\"\r\n      + service            = \"storage.googleapis.com\"\r\n    }\r\n\r\n  # google_secret_manager_secret.openvidu_shared_info[\"DASHBOARD_ADMIN_PASSWORD\"] will be created\r\n  + resource \"google_secret_manager_secret\" \"openvidu_shared_info\" {\r\n      + create_time           = (known after apply)\r\n      + deletion_policy       = \"DELETE\"\r\n      + deletion_protection   = false\r\n      + effective_annotations = (known after apply)\r\n      + effective_labels      = {\r\n          + \"goog-terraform-provisioned\" = \"true\"\r\n          + \"stack\"                      = \"openvidu-e2e-gcp-el-s113145\"\r\n        }\r\n      + expire_time           = (known after apply)\r\n      + id                    = (known after apply)\r\n      + labels                = {\r\n          + \"stack\" = \"openvidu-e2e-gcp-el-s113145\"\r\n        }\r\n      + name                  = (known after apply)\r\n      + project               = \"***\"\r\n      + secret