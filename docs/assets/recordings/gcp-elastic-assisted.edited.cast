fter apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m direction          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m enable_logging     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m firewall_id        = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id                 = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m name               = \"openvidu-e2e-gcp-el-s113145-media-firewall\"\r\n      \u001b[32m+\u001b[0m\u001b[0m network            = \"default\"\r\n      \u001b[32m+\u001b[0m\u001b[0m priority           = 1000\r\n      \u001b[32m+\u001b[0m\u001b[0m project            = \"***\"\r\n      \u001b[32m+\u001b[0m\u001b[0m self_link          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m source_ranges      = [\r\n          \u001b[32m+\u001b[0m\u001b[0m \"0.0.0.0/0\",\r\n        ]\r\n      \u001b[32m+\u001b[0m\u001b[0m target_tags        = [\r\n          \u001b[32m+\u001b[0m\u001b[0m \"openvidu-e2e-gcp-el-s113145-media-node\",\r\n        ]\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m allow {\r\n          \u001b[32m+\u001b[0m\u001b[0m ports    = [\r\n              \u001b[32m+\u001b[0m\u001b[0m \"22\",\r\n              \u001b[32m+\u001b[0m\u001b[0m \"7881\",\r\n              \u001b[32m+\u001b[0m\u001b[0m \"50000-60000\",\r\n            ]\r\n          \u001b[32m+\u001b[0m\u001b[0m protocol = \"tcp\"\r\n        }\r\n      \u001b[32m+\u001b[0m\u001b[0m allow {\r\n          \u001b[32m+\u001b[0m\u001b[0m ports    = [\r\n              \u001b[32m+\u001b[0m\u001b[0m \"443\",\r\n              \u001b[32m+\u001b[0m\u001b[0m \"7885\",\r\n              \u001b[32m+\u001b[0m\u001b[0m \"50000-60000\",\r\n            ]\r\n          \u001b[32m+\u001b[0m\u001b[0m protocol = \"udp\"\r\n        }\r\n    }\r\n"]
[19.705,"o","\r\n\u001b[1m  # google_compute_firewall.media_from_cluster\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"google_compute_firewall\" \"media_from_cluster\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m creation_timestamp = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m deletion_policy    = \"DELETE\"\r\n      \u001b[32m+\u001b[0m\u001b[0m destination_ranges = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m direction          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m enable_logging     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m firewall_id        = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id                 = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m name               = \"openvidu-e2e-gcp-el-s113145-to-media\"\r\n      \u001b[32m+\u001b[0m\u001b[0m network            = \"default\"\r\n      \u001b[32m+\u001b[0m\u001b[0m priority           = 1000\r\n      \u001b[32m+\u001b[0m\u001b[0m project            = \"***\"\r\n      \u001b[32m+\u001b[0m\u001b[0m self_link          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m source_tags        = [\r\n          \u001b[32m+\u001b[0m\u001b[0m \"openvidu-e2e-gcp-el-s113145-master-node\",\r\n          \u001b[32m+\u001b[0m\u001b[0m \"openvidu-e2e-gcp-el-s113145-media-node\",\r\n        ]\r\n      \u001b[32m+\u001b[0m\u001b[0m target_tags        = [\r\n          \u001b[32m+\u001b[0m\u001b[0m \"openvidu-e2e-gcp-el-s113145-media-node\",\r\n        ]\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m allow {\r\n          \u001b[32m+\u001b[0m\u001b[0m ports    = [\r\n              \u001b[32m+\u001b[0m\u001b[0m \"10250\",\r\n            ]\r\n          \u001b[32m+\u001b[0m\u001b[0m protocol = \"tcp\"\r\n        }\r\n      \u001b[32m+\u001b[0m\u001b[0m allow {\r\n          \u001b[32m+\u001b[0m\u001b[0m ports    = [\r\n              \u001b[32m+\u001b[0m\u001b[0m \"8472\",\r\n            ]\r\n          \u001b[32m+\u001b[0m\u001b[0m protocol = \"udp\"\r\n        }\r\n    }\r\n\r\n\u001b[1m  # google_compute_firewall.media_health_check\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"google_compute_firewall\" \"media_health_check\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m creation_timestamp = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m deletion_policy    = \"DELETE\"\r\n      \u001b[32m+\u001b[0m\u001b[0m destination_ranges = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m direction          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m enable_logging     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m firewall_id        = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id                 = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m name               = \"openvidu-e2e-gcp-el-s113145-media-health\"\r\n      \u001b[32m+\u001b[0m\u001b[0m network            = \"default\"\r\n      \u001b[32m+\u001b[0m\u001b[0m priority           = 1000\r\n      \u001b[32m+\u001b[0m\u001b[0m project            = \"***\"\r\n      \u001b[32m+\u001b[0m\u001b[0m self_link          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m source_ranges      = [\r\n          \u001b[32m+\u001b[0m\u001b[0m \"130.211.0.0/22\",\r\n          \u001b[32m+\u001b[0m\u001b[0m \"35.191.0.0/16\",\r\n        ]\r\n      \u001b[32m+\u001b[0m\u001b[0m target_tags        = [\r\n          \u001b[32m+\u001b[0m\u001b[0m \"openvidu-e2e-gcp-el-s113145-media-node\",\r\n        ]\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m allow {\r\n          \u001b[32m+\u001b[0m\u001b[0m ports    = [\r\n              \u001b[32m+\u001b[0m\u001b[0m \"7780\",\r\n            ]\r\n          \u001b[32m+\u001b[0m\u001b[0m protocol = \"tcp\"\r\n        }\r\n    }\r\n\r\n\u001b[1m  # google_compute_firewall.openvidu\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"google_compute_firewall\" \"openvi