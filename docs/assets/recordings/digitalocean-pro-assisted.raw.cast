[539.042,"o","ov stack destroy -y --delete-data\r\n"]
[539.107,"o","── PLAN · nothing below has run ───────────────────────────────────────\r\nThis is what will be deleted from your DigitalOcean account:\r\n\r\n  # Everything the Terraform state in .openvidu/digitalocean holds: the Droplet, its\r\n  # firewall, its tag, the SSH key, the Spaces key, the Space with the recordings and Meet\r\n  # data. A Space must be empty to go, and the master writes into it until it is gone, so\r\n  # the Spaces are emptied between two passes; only a Space the state holds is emptied,\r\n  # never one of your own (SpaceName).\r\n  terraform -chdir=.openvidu/digitalocean init -input=false -no-color -force-copy\r\n  env OPENVIDU_STACK_DESTROY=1 terraform -chdir=.openvidu/digitalocean destroy -auto-approve -input=false -no-color\r\n  env AWS_ACCESS_KEY_ID=$SPACES_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY=$SPACES_SECRET_ACCESS_KEY AWS_SESSION_TOKEN= aws s3 rm s3://openvidu-e2e-do-pro-s130429-space-e408d4a7d7 --recursive --endpoint-url https://fra1.digitaloceanspaces.com\r\n  env OPENVIDU_STACK_DESTROY=1 terraform -chdir=.openvidu/digitalocean destroy -auto-approve -input=false -no-color\r\n\r\n--delete-data: the recordings and Meet data are in the Space: this deletes them.\r\n── end of plan ────────────────────────────────────────────────────────\r\n\r\n"]
