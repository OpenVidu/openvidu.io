[53.614,"o","[\r\n    {\r\n        \"OutputKey\": \"SharedInfoSecret\",\r\n        \"OutputValue\": \"openvidu-ha-eu-south-2-openvidu-e2e-aws-ha-s132931\",\r\n        \"Description\": \"Name of the Secrets Manager secret this stack publishes to.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"PublicIp\",\r\n        \"OutputValue\": \"35.42.27.69\",\r\n        \"Description\": \"Public IPv4 address of master-1 (what a client deploys to over SSH). The DEPLOYMENT is reached through the load balancer, not here.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"OperateFromAnywhere\",\r\n        \"OutputValue\": \"mkdir openvidu && cd openvidu && ov stack import openvidu --ssh ubuntu@35.42.27.69 --ssh-key ./<your-key>.pem\",\r\n"]
[53.615,"o","        \"Description\": \"Operate this stack from your own machine with the OpenVidu CLI: adopt it into an empty\\ndirectory with the SSH key this stack was launched with. The import reads the stack's\\naccess from master-1, and the CLI administers it over the masters' port 6443,\\nso ClusterApiAllowedCidr has to let your machine in.\\n\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"ClusterDataBucket\",\r\n        \"OutputValue\": \"openvidu-clusterdata-c6eb1970\",\r\n        \"Description\": \"S3 bucket for the clustered Mimir and Loki.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"S3Endpoint\",\r\n        \"OutputValue\": \"https://s3.eu-south-2.amazonaws.com\",\r\n        \"Description\": \"S3 endpoint for the bucket above.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"MediaNodeAutoScalingGroupName\",\r\n        \"OutputValue\": \"openvidu-ha-media-asg-eu-south-2-openvidu-e2e-aws-ha-s132931\",\r\n        \"Description\": \"The media tier's auto scaling group (its size is what scales).\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"AppDataBucket\",\r\n        \"OutputValue\": \"openvidu-appdata-c6eb1970\",\r\n        \"Description\": \"S3 bucket for recordings and Meet data.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"NLBDNS\",\r\n        \"OutputValue\": \"openvi-OpenV-SlcrwV5h8p2s-77fa391dfe41df14.elb.eu-south-2.amazonaws.com\",\r\n        \"Description\": \"DNS name of the load balancer. Without HostedZoneId, POINT DomainName AT THIS VALUE (a CNAME, or an ALIAS record) ? nothing serves the domain until you do.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"AdministrationEndpoint\",\r\n        \"OutputValue\": \"https://35.42.27.69:6443\",\r\n        \"Description\": \"The port on master-1 (6443) the OpenVidu CLI administers the stack through. Any master serves it.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"SSHCommand\",\r\n        \"OutputValue\": \"ssh -i <your-key>.pem ubuntu@35.42.27.69\",\r\n        \"Description\": \"Shell on master-1 (operate the stack from there with `sudo ov stack ?`).\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"ApplicationURL\",\r\n        \"OutputValue\": \"https://openvidu-ha-test.dev.openvidu.io/\",\r\n        \"Description\": \"Public URL, once DomainName resolves to the load balancer.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"ServicesAndCredentials\",\r\n        \"OutputValue\": \"https://eu-south-2.console.aws.amazon.com/secretsmanager/home?region=eu-south-2#!/secret?name=openvidu-ha-eu-south-2-openvidu-e2e-aws-ha-s132931\",\r\n        \"Description\": \"Console URL to the Secrets Manager secret. With DeployedBy=instance it holds the deployment's URLs and credentials, and the access the OpenVidu CLI administers it with; with DeployedBy=client it holds only the two S3 buckets and their keys, for your own deploy to consume.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"NextStep\",\r\n        \"OutputValue\": \"OpenVidu is serving on https://openvidu-ha-test.dev.openvidu.io/ (this stack created its record in Route 53): master-1 deployed the stack, masters 2-4 and the media nodes join as they boot. URLs and credentials are in the secret openvidu-ha-eu-south-2-openvidu-e2e-aws-ha-s132931.\",\r\n        \"Description\": \"What to do now.\"\r\n    }\r\n]\r\n"]
