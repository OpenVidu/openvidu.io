[466.241,"o","[\r\n    {\r\n        \"OutputKey\": \"SSHCommand\",\r\n        \"OutputValue\": \"ssh -i <your-key>.pem ubuntu@89.60.2.109\",\r\n        \"Description\": \"Shell on the node (operate the stack from there with `sudo ov stack ?`).\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"ApplicationURL\",\r\n        \"OutputValue\": \"https://ec2-89-60-2-109.eu-south-2.compute.amazonaws.com/\",\r\n        \"Description\": \"Public URL (DeployedBy=instance; the real domain is DOMAIN_NAME in the secret).\"\r\n    },\r\n"]
[466.242,"o","    {\r\n        \"OutputKey\": \"SharedInfoSecret\",\r\n        \"OutputValue\": \"openvidu-eu-south-2-openvidu-e2e-aws-ce-s125307\",\r\n        \"Description\": \"Name of the Secrets Manager secret this stack publishes to.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"ServicesAndCredentials\",\r\n        \"OutputValue\": \"https://eu-south-2.console.aws.amazon.com/secretsmanager/home?region=eu-south-2#!/secret?name=openvidu-eu-south-2-openvidu-e2e-aws-ce-s125307\",\r\n        \"Description\": \"Console URL to the Secrets Manager secret holding the deployment's URLs and credentials (DeployedBy=instance).\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"PublicIp\",\r\n        \"OutputValue\": \"89.60.2.109\",\r\n        \"Description\": \"Public IPv4 address of the node (what a client deploys to over SSH).\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"OperateFromAnywhere\",\r\n        \"OutputValue\": \"mkdir openvidu && cd openvidu && ov stack import openvidu --ssh ubuntu@89.60.2.109 --ssh-key ./<your-key>.pem\",\r\n        \"Description\": \"Operate this stack from your own machine with the OpenVidu CLI. A Community deployment is\\nadministered over SSH ? there is no in-stack console ? so adopt it into an empty directory\\nwith the SSH key this stack was launched with. The import reads the description the deploy\\npublished on the node, credentials included, and writes this directory's openvidu-stack.yml.\\n\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"S3Endpoint\",\r\n        \"OutputValue\": \"https://s3.eu-south-2.amazonaws.com\",\r\n        \"Description\": \"S3 endpoint for the bucket above.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"AppDataBucket\",\r\n        \"OutputValue\": \"openvidu-appdata-b04a0be0\",\r\n        \"Description\": \"S3 bucket for recordings and Meet data.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"NextStep\",\r\n        \"OutputValue\": \"OpenVidu is deployed and serving. URLs and credentials are in the secret openvidu-eu-south-2-openvidu-e2e-aws-ce-s125307.\",\r\n        \"Description\": \"What to do now.\"\r\n    }\r\n]\r\n"]
