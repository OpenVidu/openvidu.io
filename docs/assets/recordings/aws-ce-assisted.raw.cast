[1.014,"m","Deploy (--mode assisted): ov prints the commands and runs nothing"]
[1.014,"o","$ "]
[1.015,"o","ov stack deploy openvidu-e2e-aws-ce-s125307 --cloud aws --aws-region \"$AWS_REGION\" --edition community --certificate-type selfsigned --mode assisted\r\n"]
