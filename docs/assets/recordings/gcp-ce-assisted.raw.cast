[13.966,"o","\r\n\u001b[1m  # google_compute_address.public_ip[0]\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"google_compute_address\" \"public_ip\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m address            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m address_id         = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m address_type       = \"EXTERNAL\"\r\n      \u001b[32m+\u001b[0m\u001b[0m creation_timestamp = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m deletion_policy    = \"DELETE\"\r\n      \u001b[32m+\u001b[0m\u001b[0m effective_labels   = {\r\n          \u001b[32m+\u001b[0m\u001b[0m \"goog-terraform-provisioned\" = \"true\"\r\n        }\r\n      \u001b[32m+\u001b[0m\u001b[0m id                 = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m label_fingerprint  = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m name               = \"openvidu-e2e-gcp-ce-s125447-public-ip\"\r\n      \u001b[32m+\u001b[0m\u001b[0m network_tier       = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m prefix_length      = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m project            = \"***\"\r\n      \u001b[32m+\u001b[0m\u001b[0m purpose            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m region             = \"europe-west2\"\r\n      \u001b[32m+\u001b[0m\u001b[0m self_link          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m subnetwork         = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m terraform_labels   = {\r\n          \u001b[32m+\u001b[0m\u001b[0m \"goog-terraform-provisioned\" = \"true\"\r\n        }\r\n      \u001b[32m+\u001b[0m\u001b[0m users              = (known after apply)\r\n    }\r\n\r\n\u001b[1m  # google_compute_firewall.openvidu\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"google_compute_firewall\" \"openvidu\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m creation_timestamp = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m deletion_policy    = \"DELETE\"\r\n      \u001b[32m+\u001b[0m\u001b[0m destination_ranges = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m direction          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m enable_logging     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m firewall_id        = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id                 = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m name               = \"openvidu-e2e-gcp-ce-s125447-ce-firewall\"\r\n      \u001b[32m+\u001b[0m\u001b[0m network            = \"default\"\r\n      \u001b[32m+\u001b[0m\u001b[0m priority           = 1000\r\n      \u001b[32m+\u001b[0m\u001b[0m project            = \"***\"\r\n      \u001b[32m+\u001b[0m\u001b[0m self_link          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m source_ranges      = [\r\n          \u001b[32m+\u001b[0m\u001b[0m \"0.0.0.0/0\",\r\n        ]\r\n      \u001b[32m+\u001b[0m\u001b[0m target_tags        = [\r\n          \u001b[32m+\u001b[0m\u001b[0m \"openvidu-e2e-gcp-ce-s125447-vm-ce\",\r\n        ]\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m allow {\r\n          \u001b[32m+\u001b[0m\u001b[0m ports    = [\r\n              \u001b[32m+\u001b[0m\u001b[0m \"22\",\r\n              \u001b[32m+\u001b[0m\u001b[0m \"80\",\r\n              \u001b[32m+\u001b[0m\u001b[0m \"443\",\r\n              \u001b[32m+\u001b[0m\u001b[0m \"1935\",\r\n              \u001b[32m+\u001b[0m\u001b[0m \"7881\",\r\n            ]\r\n          \u001b[32m+\u001b[0m\u001b[0m protocol = \"tcp\"\r\n        }\r\n      \u001b[32m+\u001b[0m\u001b[0m allow {\r\n          \u001b[32m+\u001b[0m\u001b[0m ports    = [\r\n              \u001b[32m+\u001b[0m\u001b[0m \"443\",\r\n              \u001b[32m+\u001b[0m\u001b[0m \"7885\",\r\n              \u001b[32m+\u001b[0m\u001b[0m \"50000-60000\",\r\n            ]\r\n          \u001b[32m+\u001b[0m