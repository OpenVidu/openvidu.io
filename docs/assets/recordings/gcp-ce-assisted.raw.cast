app_data[\"storage|roles/storage.objectAdmin\"]\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"google_storage_bucket_iam_member\" \"app_data\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m bucket = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m etag   = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m member = \"serviceAccount:openvidu-e2e-gcp-b0ca24-gcs-sa@***.iam.gserviceaccount.com\"\r\n      \u001b[32m+\u001b[0m\u001b[0m role   = \"roles/storage.objectAdmin\"\r\n    }\r\n\r\n\u001b[1m  # random_id.bucket_suffix\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"random_id\" \"bucket_suffix\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m b64_std     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m b64_url     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m byte_length = 3\r\n      \u001b[32m+\u001b[0m\u001b[0m dec         = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m hex         = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id          = (known after apply)\r\n    }\r\n\r\n\u001b[1m  # tls_private_key.ssh\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"tls_private_key\" \"ssh\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m algorithm                     = \"ED25519\"\r\n      \u001b[32m+\u001b[0m\u001b[0m ecdsa_curve                   = \"P224\"\r\n      \u001b[32m+\u001b[0m\u001b[0m id                            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m private_key_openssh           = (sensitive value)\r\n      \u001b[32m+\u001b[0m\u001b[0m private_key_pem               = (sensitive value)\r\n      \u001b[32m+\u001b[0m\u001b[0m private_key_pem_pkcs8         = (sensitive value)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_fingerprint_md5    = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_fingerprint_sha256 = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_openssh            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_pem                = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m rsa_bits                      = 2048\r\n    }\r\n\r\n\u001b[1mPlan:\u001b[0m 91 to add, 0 to change, 0 to destroy.\r\n\u001b[0m\r\nChanges to Outputs:\r\n  \u001b[32m+\u001b[0m\u001b[0m app_data_bucket          = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m next_step                = \"OpenVidu is deployed (it serves once the secret openvidu-e2e-gcp-ce-s125447-OPENVIDU_URL exists). URLs and credentials are in the Secret Manager secrets prefixed openvidu-e2e-gcp-ce-s125447-.\"\r\n  \u001b[32m+\u001b[0m\u001b[0m operate_from_anywhere    = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m public_ip                = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m secret_prefix            = \"openvidu-e2e-gcp-ce-s125447-\"\r\n  \u001b[32m+\u001b[0m\u001b[0m services_and_credentials = \"https://console.cloud.google.com/security/secret-manager?project=***\"\r\n  \u001b[32m+\u001b[0m\u001b[0m ssh_command              = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m ssh_private_key          = (sensitive value)\r\n  \u001b[32m+\u001b[0m\u001b[0m ssh_user                 = \"ubuntu\"\r\n\u001b[90m\r\n───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\nNote: You didn't use the -out option to save this plan, so Terraform can't guarantee to take exactly these actions if\r\nyou run \"terraform apply\" now.\r\n"]
[14.162,"m","The runbook's commands, exactly as ov printed them 3/6"]
[14.162,"o","\u001b[2m# Create the machine. deployedBy=instance: it installs OpenVidu on itself with the\r\n# OpenVidu CLI. `apply` returns when Terraform is done (about 2 minutes, then OpenVidu installs); OpenVidu comes up after.\u001b[0m\r\n"]
[14.162,"o","$ "]
[14.163,"o","terraform -chdir=.openvidu/gcp apply -auto-approve -input=false -no-color\r\n"]
[15.289,"o","\r\nTerraform used the selected providers to generate the following execution plan. Resource actions are indicated with the\r\nfollowing symbols:\r\n  + create\r\n\r\nTerraform will perform the following actions:\r\n"]
[15.289,"o","\r\n  # google_compute_address.public_ip[0] will be created\r\n  + resource \"google_compute_address\" \"public_ip\" {\r\n      + address            = (known after apply)\r\n      + address_id         = (known after apply)\r\n      + address_type       = \"EXTERNAL\"\r\n      + creation_timestamp = (known after apply)\r\n      + deletion_policy    = \"DELETE\"\r\n      + effective_labels   = {\r\n          + \"goog-terraform-provisioned\" = \"true\"\r\n        }\r\n      + id                 = (known after apply)\r\n      + label_fingerprint  = (known after apply)\r\n      + name               = \"openvidu-e2e-gcp-ce-s125447-public-ip\"\r\n      + network_tier       = (known after apply)\r\n      + prefix_length      = (known after apply)\r\n      + project            = \"***\"\r\n      + purpose            = (known after apply)\r\n      + region             = \"europe-west2\"\r\n      + self_link          = (known after apply)\r\n      + subnetwork         = (known after apply)\r\n      + terraform_labels   = {\r\n          + \"goog-terraform-provisioned\" = \"true\"\r\n        }\r\n      + users              = (known after apply)\r\n    }\r\n\r\n  # google_compute_firewall.openvidu will be created\r\n  + resource \"google_compute_firewall\" \"openvidu\" {\r\n      + creation_timestamp = (known after apply)\r\n      + deletion_policy    = \"DELETE\"\r\n      + destination_ranges = (known after apply)\r\n      + direction          = (known after apply)\r\n      + enable_logging     = (known after apply)\r\n      + firewall_id        = (known after apply)\r\n      + id                 = (known after apply)\r\n      + name               = \"openvidu-e2e-gcp-ce-s125447-ce-firewall\"\r\n      + network            = \"default\"\r\n      + priority           = 1000\r\n      + project            = \"***\"\r\n      + self_link          = (known after apply)\r\n      + source_ranges      = [\r\n          + \"0.0.0.0/0\",\r\n        ]\r\n      + target_tags        = [\r\n          + \"openvidu-e2e-gcp-ce-s125447-vm-ce\",\r\n        ]\r\n\r\n      + allow {\r\n          + ports    = [\r\n              + \"22\",\r\n              + \"80\",\r\n              + \"443\",\r\n              + \"1935\",\r\n              + \"7881\",\r\n            ]\r\n          + protocol = \"tcp\"\r\n        }\r\n      + allow {\r\n          + ports    = [\r\n              + \"443\",\r\n              + \"7885\",\r\n              + \"50000-60000\",\r\n            ]\r\n          + protocol = \"udp\"\r\n        }\r\n    }\r\n\r\n  # google_compute_instance.openvidu_server will be created\r\n  + resource \"google_compute_instance\" \"openvidu_server\" {\r\n      + allow_stopping_for_update = true\r\n      + can_ip_forward            = false\r\n      + cpu_platform              = (known after apply)\r\n      + creation_timestamp        = (known after apply)\r\n      + current_status            = (known after apply)\r\n      + deletion_policy           = \"DELETE\"\r\n      + deletion_protection       = false\r\n      + effective_labels          = {\r\n          + \"goog-terraform-provisioned\" = \"true\"\r\n          + \"node-type\"                  = \"single-node\"\r\n          + \"stack\"                      = \"openvidu-e2e-gcp-ce-s125447\"\r\n        }\r\n      + id                        = (known after apply)\r\n      + instance_id               = (known after apply)\r\n      + label_fingerprint         = (known after apply)\r\n      + labels                    = {\r\n          + \"node-type\" = \"single-node\"\r\n          + \"stack\"     = \"openvidu-e2e-gcp-ce-s125447\"\r\n        }\r\n      + machine_type              = \"e2-standard-4\"\r\n      + metadata                  = (known after apply)\r\n      + metadata_fingerprint      = (known after apply)\r\n      + metadata_startup_script   = (sensitive value)\r\n      + min_cpu_platform          = (known after apply)\r\n      + name                      = \"openvidu-e2e-gcp-ce-s125447-vm-ce\"\r