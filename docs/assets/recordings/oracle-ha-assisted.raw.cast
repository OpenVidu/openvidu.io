[260.122,"o","administration_endpoint = \"https://51.170.42.93:6443\"\r\napp_data_bucket = \"openvidu-e2e-oci-ha-s124040-appdata-40bebd\"\r\ncluster_data_bucket = \"openvidu-e2e-oci-ha-s124040-clusterdata-40bebd\"\r\nmaster_node_public_ips = {\r\n  \"1\" = \"51.170.42.93\"\r\n  \"2\" = \"51.170.41.241\"\r\n  \"3\" = \"141.253.198.137\"\r\n  \"4\" = \"130.110.234.176\"\r\n}\r\nmedia_node_pool = \"openvidu-e2e-oci-ha-s124040-media-pool\"\r\nmedia_node_pool_id = \"ocid1.instancepool.oc1.eu-madrid-1.aaaaaaaau4o74rsea6cls7bpdmtlov32mzocylm23vymwo2bxlqaw22oso4a\"\r\nnext_step = \"OpenVidu is deployed and serving on the load balancer (the nlb_public_ip output), and masters 2-4 and the media nodes join as they boot. URLs and credentials are in the vault ov-cloud-tester-vault-4 (secrets DOMAIN_NAME, LB_PUBLIC_IP, OPENVIDU_URL, LIVEKIT_*…). To administer it from your own machine with the OpenVidu CLI, run what operate_from_anywhere says.\"\r\nnlb_public_ip = \"51.170.41.40\"\r\noperate_from_anywhere = \"oci os object get --namespace *** --bucket-name openvidu-e2e-oci-ha-s124040-appdata-40bebd --name openvidu_private_ssh_key_openvidu-e2e-oci-ha-s124040.pem --file openvidu-e2e-oci-ha-s124040-key.pem --region eu-madrid-1 && chmod 600 openvidu-e2e-oci-ha-s124040-key.pem && mkdir openvidu && cd openvidu && ov stack import openvidu --ssh ubuntu@51.170.42.93 --ssh-key ../openvidu-e2e-oci-ha-s124040-key.pem\"\r\npublic_ip = \"51.170.42.93\"\r\ns3_endpoint = \"https://***.compat.objectstorage.eu-madrid-1.oraclecloud.com\"\r\nssh_command = \"ssh -i <private-key>.pem ubuntu@51.170.42.93\"\r\nssh_private_key_object = \"openvidu-e2e-oci-ha-s124040-appdata-40bebd/openvidu_private_ssh_key_openvidu-e2e-oci-ha-s124040.pem\"\r\nvault_id = \"***\"\r\n"]
[260.297,"m","The runbook's commands, exactly as ov printed them 5/6"]
[260.297,"o","\u001b[2m# What the stack published: URL, credentials and the stack's access, as secrets in the stack's vault, base64 (KUBECONFIG\r\n# appears once OpenVidu is up: until then this read fails, and the command that continues the deploy waits for it).\u001b[0m\r\n"]
[260.297,"o","$ "]
[260.298,"o","VAULT=\"$(terraform -chdir=.openvidu/oracle output -raw vault_id)\"\r\n"]
[260.746,"m","The runbook's commands, exactly as ov printed them 6/6"]
[260.746,"o","$ "]
[260.747,"o","oci secrets secret-bundle get-secret-bundle-by-name --secret-name KUBECONFIG --vault-id $VAULT --query 'data.\"secret-bundle-content\".content' --raw-output --region eu-madrid-1 | base64 -d\r\n"]
[261.245,"o","apiVersion: v1\r\nclusters:\r\n- cluster:\r\n    certificate-authority-data: \r\n    server: https://51.170.37.32:6443\r\n  name: default\r\ncontexts:\r\n- context:\r\n    cluster: default\r\n    user: default\r\n  name: default\r\ncurrent-context: default\r\nkind: Config\r\nusers:\r\n- name: default\r\n  user:\r\n    client-certificate-data: ***\r\n"]
[261.245,"o","    client-key-data: ***"]
