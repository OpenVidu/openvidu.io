[505.291,"o","oci secrets secret-bundle get-secret-bundle-by-name --secret-name KUBECONFIG --vault-id $VAULT --query 'data.\"secret-bundle-content\".content' --raw-output --region eu-madrid-1 | base64 -d\r\n"]
