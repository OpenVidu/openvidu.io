[145.882,"o","null_resource.media_node_count (local-exec): Executing: [\"/bin/sh\" \"-c\" \"set -eu\\nlog() { echo \\\"[media-nodes] $*\\\"; }\\nSIZE=$(oci compute-management instance-pool get --region \\\"$REGION\\\" --instance-pool-id \\\"$POOL_ID\\\" --query 'data.size' --raw-output)\\nif [ \\\"$FIXED\\\" -gt 0 ]; then\\n  TARGET=\\\"$FIXED\\\"\\nelse\\n  # Moving to the autoscaler: its start sets the pool to the initial number, so the\\n  # pool goes there first. Already autoscaled: the number stays within the limits.\\n  HAVE=$(oci autoscaling configuration list --region \\\"$REGION\\\" --compartment-id \\\"$COMPARTMENT_ID\\\" --all --output json \\\\\\n    | jq -r --arg n \\\"$AUTOSCALING\\\" '[.data[] | select(.\\\"display-name\\\" == $n)] | length')\\n  if [ \\\"$HAVE\\\" = \\\"0\\\" ]; then\\n    TARGET=\\\"$INITIAL\\\"\\n  else\\n    TARGET=\\\"$SIZE\\\"\\n    [ \\\"$TARGET\\\" -lt \\\"$MIN\\\" ] && TARGET=\\\"$MIN\\\"\\n    [ \\\"$TARGET\\\" -gt \\\"$MAX\\\" ] && TARGET=\\\"$MAX\\\"\\n  fi\\nfi\\nlog \\\"the pool has $SIZE media node(s); this apply sets $TARGET\\\"\\ngrow() {\\n  log \\\"the pool goes to $1 media node(s)\\\"\\n  oci compute-management instance-pool update --region \\\"$REGION\\\" --instance-pool-id \\\"$POOL_ID\\\" --size \\\"$1\\\" --force >/dev/null\\n}\\nif [ \\\"$SIZE\\\" -le \\\"$TARGET\\\" ]; then\\n  [ \\\"$SIZE\\\" -lt \\\"$TARGET\\\" ] && grow \\\"$TARGET\\\"\\n  exit 0\\nfi\\nGOING=$(oci compute-management instance-pool list-instances --region \\\"$REGION\\\" --compartment-id \\\"$COMPARTMENT_ID\\\" \\\\\\n    --instance-pool-id \\\"$POOL_ID\\\" --all --output json \\\\\\n  | jq -r '.data | sort_by(.\\\"time-created\\\") | reverse | .[].id' | head -n \\\"$((SIZE - TARGET))\\\")\\nfor ID in $GOING; do\\n  log \\\"detach $ID from the pool: it drains, leaves and terminates itself\\\"\\n  oci compute-management instance-pool-instance detach --region \\\"$REGION\\\" --instance-pool-id \\\"$POOL_ID\\\" \\\\\\n    --instance-id \\\"$ID\\\" --is-decrement-size true --is-auto-terminate false >/dev/null\\ndone\\nDEADLINE=$(( $(date +%s) + ${OPENVIDU_MEDIA_DRAIN_TIMEOUT:-7200} ))\\nfor ID in $GOING; do\\n  log \\\"waiting for $ID to drain; its own log: oci compute console-history capture --instance-id $ID, then oci compute console-history get-content --length 1000000 --file - --instance-console-history-id <the id it prints>\\\"\\n  LAST=\\\"\\\"\\n  while :; do\\n    # Its state, and how far its leaving went: the node tags itself openvidu-scale-in=\\n    # draining, then left. A node that left has nothing on it any more.\\n    INFO=$(oci compute instance get --region \\\"$REGION\\\" --instance-id \\\"$ID\\\" --output json 2>/dev/null \\\\\\n      | jq -r '.data | \\\"\\\\(.\\\"lifecycle-state\\\") \\\\(.\\\"freeform-tags\\\"[\\\"openvidu-scale-in\\\"] // \\\"-\\\")\\\"' 2>/dev/null || true)\\n    [ -n \\\"$INFO\\\" ] || INFO=\\\"TERMINATED -\\\"\\n    STATE=${INFO%% *}\\n    STEP=${INFO#* }\\n    [ \\\"$STEP\\\" != \\\"$LAST\\\" ] && [ \\\"$STEP\\\" != \\\"-\\\" ] && log \\\"$ID: $STEP\\\"\\n    LAST=\\\"$STEP\\\"\\n    case \\\"$STATE\\\" in\\n      TERMINATING|TERMINATED) log \\\"$ID is gone\\\"; break ;;\\n      STOPPED) log \\\"$ID drained and stopped: terminating it\\\"; oci compute instance terminate --region \\\"$REGION\\\" --instance-id \\\"$ID\\\" --force || true; break ;;\\n    esac\\n    if [ \\\"$STEP\\\" = left ]; then\\n      log \\\"$ID left the cluster: terminating it\\\"\\n      oci compute instance terminate --region \\\"$REGION\\\" --instance-id \\\"$ID\\\" --force || true\\n      break\\n    fi\\n    if [ \\\"$(date +%s)\\\" -ge \\\"$DEADLINE\\\" ]; then\\n      log \\\"WARN: $ID still runs past OPENVIDU_MEDIA_DRAIN_TIMEOUT: terminating it as it is\\\"\\n      oci compute instance terminate --region \\\"$REGION\\\" --instance-id \\\"$ID\\\" --force || true\\n      break\\n    fi\\n    sleep 20\\n  done\\ndone\\n# The scale-in Function may have taken one more meanwhile.\\nSIZE=$(oci compute-management instance-pool get --region \\\"$REGION\\\" --instance-pool-id \\\"$POOL_ID\\\" --query 'data.size' --raw-output)\\n[ \\\"$SIZE\\\" -lt \\\"$TARGET\\\" ] && grow \\\"$TARGET\\\"\\nexit 0\\n\"]\r\n"]
