    \u001b[32m+\u001b[0m\u001b[0m compartment_id = \"***\"\r\n      \u001b[32m+\u001b[0m\u001b[0m defined_tags   = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m description    = \"Dynamic group for the OpenVidu scale-in OCI Function of openvidu-e2e-oci-ha-s133741\"\r\n      \u001b[32m+\u001b[0m\u001b[0m freeform_tags  = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id             = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m inactive_state = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m matching_rule  = \"ALL {resource.type='fnfunc', resource.compartment.id='***'}\"\r\n      \u001b[32m+\u001b[0m\u001b[0m name           = \"openvidu-e2e-oci-ha-s133741-af17f42d-scalein-fn-dg\"\r\n      \u001b[32m+\u001b[0m\u001b[0m state          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m time_created   = (known after apply)\r\n    }\r\n\r\n\u001b[1m  # oci_identity_policy.openvidu_secrets_policy\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"oci_identity_policy\" \"openvidu_secrets_policy\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m ETag           = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m compartment_id = \"***\"\r\n      \u001b[32m+\u001b[0m\u001b[0m defined_tags   = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m description    = \"Allow the OpenVidu nodes of openvidu-e2e-oci-ha-s133741 to manage secrets, use keys and run the media tier lifecycle\"\r\n      \u001b[32m+\u001b[0m\u001b[0m freeform_tags  = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id             = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m inactive_state = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m lastUpdateETag = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m name           = \"openvidu-e2e-oci-ha-s133741-af17f42d-secrets-policy\"\r\n      \u001b[32m+\u001b[0m\u001b[0m policyHash     = (known after apply)\r\n      \u001b[32m+