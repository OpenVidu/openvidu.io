[504.841,"o","\u001b[2m# What the stack published: URL, credentials and the stack's access, as secrets in the stack's vault, base64 (KUBECONFIG\r\n# appears once OpenVidu is up: until then this read fails, and ov waits for it).\u001b[0m\r\n"]
[504.841,"o","$ "]
[504.841,"o","VAULT=\"$(terraform -chdir=.openvidu/oracle output -raw vault_id)\"\r\n"]
