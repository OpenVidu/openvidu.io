[18.446,"o","\r\nTerraform used the selected providers to generate the following execution plan. Resource actions are indicated with the\r\nfollowing symbols:\r\n  \u001b[32m+\u001b[0m create\u001b[0m\r\n\r\nTerraform will perform the following actions:\r\n\r\n\u001b[1m  # null_resource.cleanup_orphaned_media_nodes\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"null_resource\" \"cleanup_orphaned_media_nodes\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m id       = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m triggers = {\r\n          \u001b[32m+\u001b[0m\u001b[0m \"compartment_id\" = \"***\"\r\n          \u001b[32m+\u001b[0m\u001b[0m \"stack_name\"     = \"openvidu-e2e-oci-ha-s133741\"\r\n        }\r\n    }\r\n\r\n\u001b[1m  # null_resource.empty_bucket\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"null_resource\" \"empty_bucket\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m id       = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m triggers = {\r\n          \u001b[32m+\u001b[0m\u001b[0m \"bucket\"    = (known after apply)\r\n          \u001b[32m+\u001b[0m\u001b[0m \"namespace\" = \"***\"\r\n          \u001b[32m+\u001b[0m\u001b[0m \"region\"    = \"eu-madrid-1\"\r\n        }\r\n    }\r\n\r\n\u001b[1m  # null_resource.empty_cluster_bucket\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"null_resource\" \"empty_cluster_bucket\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m id       = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m triggers = {\r\n          \u001b[32m+\u001b[0m\u001b[0m \"bucket\"    = (known after apply)\r\n          \u001b[32m+\u001b[0m\u001b[0m \"namespace\" = \"***\"\r\n          \u001b[32m+\u001b[0m\u001b[0m \"region\"    = \"eu-madrid-1\"\r\n        }\r\n    }\r\n"]
[18.447,"o","\r\n\u001b[1m  # null_resource.media_node_count\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"null_resource\" \"media_node_count\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m id       = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m triggers = {\r\n          \u001b[32m+\u001b[0m\u001b[0m \"mode\"   = \"autoscaling\"\r\n          \u001b[32m+\u001b[0m\u001b[0m \"target\" = \"1-4\"\r\n        }\r\n    }\r\n\r\n\u001b[1m  # oci_autoscaling_auto_scaling_configuration.media_node_autoscaling[0]\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"oci_autoscaling_auto_scaling_configuration\" \"media_node_autoscaling\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m compartment_id       = \"***\"\r\n      \u001b[32m+\u001b[0m\u001b[0m cool_down_in_seconds = 300\r\n      \u001b[32m+\u001b[0m\u001b[0m defined_tags         = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m display_name         = \"openvidu-e2e-oci-ha-s133741-autoscaling\"\r\n      \u001b[32m+\u001b[0m\u001b[0m freeform_tags        = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id                   = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m is_enabled           = true\r\n      \u001b[32m+\u001b[0m\u001b[0m max_resource_count   = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m min_resource_count   = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m time_created         = (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m auto_scaling_resources {\r\n          \u001b[32m+\u001b[0m\u001b[0m id   = (known after apply)\r\n          \u001b[32m+\u001b[0m\u001b[0m type = \"instancePool\"\r\n        }\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m policies {\r\n          \u001b[32m+\u001b[0m\u001b[0m display_name = \"cpu-policy\"\r\n          \u001b[32m+\u001b[0m\u001b[0m id           = (known after apply)\r\n          \u001b[32m+\u001b[0m\u001b[0m is_enabled   = (known after ap