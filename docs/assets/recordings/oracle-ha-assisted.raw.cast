[16.894,"o","\u001b[2m# Create the machines. deployedBy=instance: master-1 installs OpenVidu with the\r\n# OpenVidu CLI and the other nodes join it. `apply` returns when Terraform is done (about 5 minutes, then OpenVidu installs).\u001b[0m\r\n"]
[16.894,"o","$ "]
[16.895,"o","terraform -chdir=.openvidu/oracle apply -auto-approve -input=false -no-color\r\n"]
