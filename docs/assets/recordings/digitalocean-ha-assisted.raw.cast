[9.812,"o","\u001b[2m# Create the machines. deployedBy=instance: master-1 installs OpenVidu with the\r\n# OpenVidu CLI and the other nodes join it. `apply` returns when Terraform is done (about 3 minutes, then OpenVidu installs).\u001b[0m\r\n"]
[9.812,"o","$ "]
[9.813,"o","terraform -chdir=.openvidu/digitalocean apply -auto-approve -input=false -no-color\r\n"]
