[9.63,"o","\r\n\u001b[1m  # tls_private_key.openvidu_ssh_key\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"tls_private_key\" \"openvidu_ssh_key\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m algorithm                     = \"RSA\"\r\n      \u001b[32m+\u001b[0m\u001b[0m ecdsa_curve                   = \"P224\"\r\n      \u001b[32m+\u001b[0m\u001b[0m id                            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m private_key_openssh           = (sensitive value)\r\n      \u001b[32m+\u001b[0m\u001b[0m private_key_pem               = (sensitive value)\r\n      \u001b[32m+\u001b[0m\u001b[0m private_key_pem_pkcs8         = (sensitive value)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_fingerprint_md5    = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_fingerprint_sha256 = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_openssh            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_pem                = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m rsa_bits                      = 4096\r\n    }\r\n\r\n\u001b[1mPlan:\u001b[0m 24 to add, 0 to change, 0 to destroy.\r\n\u001b[0m\r\nChanges to Outputs:\r\n  \u001b[32m+\u001b[0m\u001b[0m administrationEndpoint = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m appDataBucket          = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m clusterDataBucket      = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m loadBalancerIp         = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m masterNodeTag          = \"openvidu-e2e-do-ha-s132741-master-node-tag\"\r\n  \u001b[32m+\u001b[0m\u001b[0m mediaNodeTag           = \"openvidu-e2e-do-ha-s132741-media-node-tag\"\r\n  \u001b[32m+\u001b[0m\u001b[0m nextStep               = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m operateFromAnywhere    = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m publicIp           