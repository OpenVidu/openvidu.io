[13.057,"o","    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"openvidu-eu-south-2-openvidu-e2e-aws-pro-s094345\",\r\n        \"Description\": \"Name of the Secrets Manager secret this stack publishes to.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"https://eu-south-2.console.aws.amazon.com/secretsmanager/home?region=eu-south-2#!/secret?name=openvidu-eu-south-2-openvidu-e2e-aws-pro-s094345\",\r\n        \"Description\": \"Console URL to the Secrets Manager secret. With DeployedBy=instance it holds the deployment's URLs and credentials, and the access the OpenVidu CLI administers it with; with DeployedBy=client it holds only the S3 bucket and its keys, for your own deploy to consume.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"15.216.232.161\",\r\n        \"Description\": \"Public IPv4 address of the node (what a client deploys to over SSH).\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"mkdir openvidu && cd openvidu && ov stack import openvidu --ssh ubuntu@15.216.232.161 --ssh-key ./<your-key>.pem\",\r\n        \"Description\": \"Operate this stack from your own machine with the OpenVidu CLI: adopt it into an empty\\ndirectory with the SSH key this stack was launched with. The import reads the stack's\\naccess from the node, and the CLI administers it over its port 6443,\\nso ClusterApiAllowedCidr has to let your machine in.\\n\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"https://s3.eu-south-2.amazonaws.com\",\r\n        \"Description\": \"S3 endpoint for the bucket above.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"openvidu-appdata-139383b0\",\r\n        \"Description\": \"S3 bucket for recordings and Meet data.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"OpenVidu is deployed and serving. URLs and credentials are in the secret openvidu-eu-south-2-openvidu-e2e-aws-pro-s094345.\",\r\n        \"Description\": \"What to do now.\"\r\n    }\r\n]\r\n"]
