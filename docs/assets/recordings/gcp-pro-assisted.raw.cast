[35.981,"o","\u001b[2m# Create the machines. deployedBy=instance: master-1 installs OpenVidu with the\r\n# OpenVidu CLI and the other nodes join it. `apply` returns when Terraform is done (about 2 minutes, then OpenVidu installs).\u001b[0m\r\n"]
[35.981,"o","$ "]
[35.982,"o","terraform -chdir=.openvidu/gcp apply -auto-approve -input=false -no-color\r\n"]
