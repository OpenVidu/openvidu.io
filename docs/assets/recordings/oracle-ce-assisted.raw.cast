[71.621,"o","\r\nApply complete! Resources: 24 added, 0 changed, 0 destroyed.\r\n\r\nOutputs:\r\n\r\napp_data_bucket = \"openvidu-e2e-oci-ce-s125537-appdata-63f964\"\r\nnext_step = \"OpenVidu is deployed and serving. URLs and credentials are in the vault ov-cloud-tester-vault-4 (secrets DOMAIN_NAME, OPENVIDU_URL, LIVEKIT_*, MEET_*…). A Community deployment is administered over SSH, so operate it from your own machine by adopting it into an empty directory: terraform output -raw ssh_private_key > openvidu.pem && chmod 600 openvidu.pem, then mkdir openvidu && cd openvidu && ov stack import openvidu --ssh ubuntu@143.47.63.29 --ssh-key ../openvidu.pem\"\r\npublic_ip = \"143.47.63.29\"\r\ns3_endpoint = \"https://***.compat.objectstorage.eu-madrid-1.oraclecloud.com\"\r\nssh_command = \"ssh -i openvidu.pem ubuntu@143.47.63.29\"\r\nssh_private_key = <sensitive>\r\nssh_private_key_object = \"openvidu-e2e-oci-ce-s125537-appdata-63f964/openvidu_private_ssh_key_openvidu-e2e-oci-ce-s125537.pem\"\r\nssh_user = \"ubuntu\"\r\nvault_id = \"***\"\r\n"]
