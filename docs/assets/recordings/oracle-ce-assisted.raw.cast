[20.016,"o","\u001b[2m# Create the machine. deployedBy=instance: it installs OpenVidu on itself with the\r\n# OpenVidu CLI. `apply` returns when Terraform is done (about 3 minutes, then OpenVidu installs); OpenVidu comes up after.\u001b[0m\r\n"]
[20.016,"o","$ "]
[20.017,"o","terraform -chdir=.openvidu/oracle apply -auto-approve -input=false -no-color\r\n"]
