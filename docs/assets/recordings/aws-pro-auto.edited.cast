[2.216,"o","ov stack deploy openvidu-e2e-aws-pro-a102129 --cloud aws --aws-region \"$AWS_REGION\" --edition pro --openvidu-pro-license \"$OPENVIDU_PRO_LICENSE\" --certificate-type selfsigned --mode auto -y\r\n"]
