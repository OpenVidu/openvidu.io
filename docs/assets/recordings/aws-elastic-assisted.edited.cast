[15.696,"o","[\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"https://35.42.223.25:6443\",\r\n        \"Description\": \"The port (6443) the OpenVidu CLI administers the stack through.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"ssh -i <your-key>.pem ubuntu@35.42.223.25\",\r\n        \"Description\": \"Shell on the master node (operate the stack from there with `sudo ov stack ?`).\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"https://ec2-35-42-223-25.eu-south-2.compute.amazonaws.com/\",\r\n        \"Description\": \"Public URL (DeployedBy=instance; the real domain is DOMAIN_NAME in the secret).\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"openvidu-elastic-eu-south-2-openvidu-e2e-aws-el-s094345\",\r\n        \"Description\": \"Name of the Secrets Manager secret this stack publishes to.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"https://eu-south-2.console.aws.amazon.com/secretsmanager/home?region=eu-south-2#!/secret?name=openvidu-elastic-eu-south-2-openvidu-e2e-aws-el-s094345\",\r\n"]
[15.696,"o","        \"Description\": \"Console URL to the Secrets Manager secret. With DeployedBy=instance it holds the deployment's URLs and credentials, and the access the OpenVidu CLI administers it with; with DeployedBy=client it holds only the S3 bucket and its keys, for your own deploy to consume.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"35.42.223.25\",\r\n        \"Description\": \"Public IPv4 address of the master node (what a client deploys to over SSH).\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"mkdir openvidu && cd openvidu && ov stack import openvidu --ssh ubuntu@35.42.223.25 --ssh-key ./<your-key>.pem\",\r\n        \"Description\": \"Operate this stack from your own machine with the OpenVidu CLI: adopt it into an empty\\ndirectory with the SSH key this stack was launched with. The import reads the stack's\\naccess from the master node, and the CLI administers it over the masters' port 6443,\\nso ClusterApiAllowedCidr has to let your machine in.\\n\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"https://s3.eu-south-2.amazonaws.com\",\r\n        \"Description\": \"S3 endpoint for the bucket above.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"openvidu-elastic-media-asg-eu-south-2-openvidu-e2e-aws-el-s094345\",\r\n        \"Description\": \"The media tier's auto scaling group (its size is what scales).\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"openvidu-appdata-cfecdf10\",\r\n        \"Description\": \"S3 bucket for recordings and Meet data.\"\r\n    },\r\n    {\r\n        \"OutputKey\": \"***\",\r\n        \"OutputValue\": \"OpenVidu is deployed and serving, and the media nodes join as they boot. URLs and credentials are in the secret openvidu-elastic-eu-south-2-openvidu-e2e-aws-el-s094345.\",\r\n        \"Description\": \"What to do now.\"\r\n    }\r\n]\r\n"]
