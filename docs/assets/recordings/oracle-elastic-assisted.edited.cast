reated   = (known after apply)\r\n    }\r\n\r\n\u001b[1m  # oci_identity_policy.openvidu_secrets_policy\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"oci_identity_policy\" \"openvidu_secrets_policy\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m ETag           = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m compartment_id = \"***\"\r\n      \u001b[32m+\u001b[0m\u001b[0m defined_tags   = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m description    = \"Allow the OpenVidu nodes of openvidu-e2e-oci-el-s131730 to manage secrets, use keys and run the media tier lifecycle\"\r\n      \u001b[32m+\u001b[0m\u001b[0m freeform_tags  = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id             = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m inactive_state = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m lastUpdateETag = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m name           = \"openvidu-e2e-oci-el-s131730-af17f42d-secrets-policy\"\r\n      \u001b[32m+\u001b[0m\u001b[0m policyHash     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m state          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m statements     = [\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Allow dynamic-group openvidu-e2e-oci-el-s131730-af17f42d-instances-dg to manage secret-family in compartment id ***\",\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Allow dynamic-group openvidu-e2e-oci-el-s131730-af17f42d-instances-dg to use vaults in compartment id ***\",\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Allow dynamic-group openvidu-e2e-oci-el-s131730-af17f42d-instances-dg to manage keys in compartment id ***\",\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Allow dynamic-group openvidu-e2e-oci-el-s131730-af17f42d-instances-dg to read secret-bundles in compartment id ***\",\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Allow dynamic-group openvidu-e2e-oci-el-s131730-af17f42d-instances-dg to manage instance-pools in compartment id ***\",\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Allow dynamic-group openvidu-e2e-oci-el-s131730-af17f42d-instances-dg to manage instances in compartment id ***\",\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Allow dynamic-group openvidu-e2e-oci-el-s131730-af17f42d-instances-dg to manage volume-family in compartment id ***\",\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Allow dynamic-group openvidu-e2e-oci-el-s131730-af17f42d-instances-dg to read metrics in compartment id ***\",\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Allow dynamic-group openvidu-e2e-oci-el-s131730-af17f42d-instances-dg to use fn-invocation in compartment id ***\",\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Allow dynamic-group openvidu-e2e-oci-el-s131730-af17f42d-instances-dg to use fn-function in compartment id ***\",\r\n        ]\r\n      \u001b[32m+\u001b[0m\u001b[0m time_created   = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m version_date   = (known after apply)\r\n    }\r\n\r\n\u001b[1m  # oci_objectstorage_bucket.openvidu_bucket[0]\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"oci_objectstorage_bucket\" \"openvidu_bucket\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m access_type                  = \"NoPublicAccess\"\r\n      \u001b[32m+\u001b[0m\u001b[0m approximate_count            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m approximate_size             = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m auto_tiering                 = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m bucket_id                    = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m bucket_scope                 = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m compartment_id               = \"***\"\r\n      \u001b[32m+\u001b[0m\u001b[0m created_by                   = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m defined_tags                 = 