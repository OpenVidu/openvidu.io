[625.828,"o","Stack:       ov-e2eh-s134432\r\nType:        ha\r\nEnvironment: azure\r\nEdition:     pro\r\nEndpoint:    https://openvidu-j0ca1g-52-236-63-234.sslip.io\r\nSpec:        openvidu-stack.yml\r\nAccess:      remote (from this directory)\r\n\r\nServices:\r\n  ov-livekit-server      1/1   running    ov-e2eh-s134432-vm-medianode000000\r\n  ov-egress              1/1   running    ov-e2eh-s134432-vm-medianode000000\r\n  ov-ingress             1/1   running    ov-e2eh-s134432-vm-medianode000000\r\n  alloy                  5/5   running    ov-e2eh-s134432-vm-masternode1,ov-e2eh-s134432-vm-masternode2,ov-e2eh-s134432-vm-masternode3,ov-e2eh-s134432-vm-masternode4,ov-e2eh-s134432-vm-medianode000000\r\n  caddy-proxy            4/4   running    ov-e2eh-s134432-vm-masternode1,ov-e2eh-s134432-vm-masternode2,ov-e2eh-s134432-vm-masternode3,ov-e2eh-s134432-vm-masternode4\r\n  grafana                1/1   running    ov-e2eh-s134432-vm-masternode2\r\n  loki                   4/4   running    ov-e2eh-s134432-vm-masternode1,ov-e2eh-s134432-vm-masternode2,ov-e2eh-s134432-vm-masternode3,ov-e2eh-s134432-vm-masternode4\r\n  mimir                  4/4   running    ov-e2eh-s134432-vm-masternode1,ov-e2eh-s134432-vm-masternode2,ov-e2eh-s134432-vm-masternode3,ov-e2eh-s134432-vm-masternode4\r\n  mongodb                4/4   running    ov-e2eh-s134432-vm-masternode1,ov-e2eh-s134432-vm-masternode2,ov-e2eh-s134432-vm-masternode3,ov-e2eh-s134432-vm-masternode4\r\n  ov-dashboard           4/4   running    ov-e2eh-s134432-vm-masternode1,ov-e2eh-s134432-vm-masternode2,ov-e2eh-s134432-vm-masternode3,ov-e2eh-s134432-vm-masternode4\r\n  ov-licensing-daemon    5/5   running    ov-e2eh-s134432-vm-masternode1,ov-e2eh-s134432-vm-masternode2,ov-e2eh-s134432-vm-masternode3,ov-e2eh-s134432-vm-masternode4,ov-e2eh-s134432-vm-medianode000000\r\n  ov-livekit-server-internal 1/1   running    ov-e2eh-s134432-vm-medianode000000\r\n"]
