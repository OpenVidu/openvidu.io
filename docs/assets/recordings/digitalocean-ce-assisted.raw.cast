[42.286,"o","\r\n\u001b[1m  # digitalocean_spaces_bucket.openvidu_space[0]\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"digitalocean_spaces_bucket\" \"openvidu_space\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m acl                = \"private\"\r\n      \u001b[32m+\u001b[0m\u001b[0m bucket_domain_name = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m endpoint           = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m force_destroy      = false\r\n      \u001b[32m+\u001b[0m\u001b[0m id                 = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m name               = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m region             = \"fra1\"\r\n      \u001b[32m+\u001b[0m\u001b[0m urn                = (known after apply)\r\n    }\r\n\r\n\u001b[1m  # digitalocean_spaces_key.openvidu_space_key\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"digitalocean_spaces_key\" \"openvidu_space_key\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m access_key = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m created_at = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id         = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m name       = \"openvidu-e2e-do-ce-s094345-space-key\"\r\n      \u001b[32m+\u001b[0m\u001b[0m secret_key = *** value)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m grant {\r\n          \u001b[32m+\u001b[0m\u001b[0m bucket     = (known after apply)\r\n          \u001b[32m+\u001b[0m\u001b[0m permission = \"readwrite\"\r\n        }\r\n    }\r\n\r\n\u001b[1m  # digitalocean_ssh_key.openvidu_ssh_key_do\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"digitalocean_ssh_key\" \"openvidu_ssh_key_do\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m fingerprint = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m name        = \"openvidu-e2e-do-ce-s094345-ssh-key\"\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key  = (known after apply)\r\n    }\r\n\r\n\u001b[1m  # digitalocean_tag.stack_tag\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"digitalocean_tag\" \"stack_tag\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m databases_count        = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m droplets_count         = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id                     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m images_count           = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m name                   = \"openvidu-e2e-do-ce-s094345\"\r\n      \u001b[32m+\u001b[0m\u001b[0m total_resource_count   = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m volume_snapshots_count = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m volumes_count          = (known after apply)\r\n    }\r\n\r\n\u001b[1m  # random_id.bucket_suffix\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"random_id\" \"bucket_suffix\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m b64_std     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m b64_url     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m byte_length = 5\r\n      \u001b[32m+\u001b[0m\u001b[0m dec         = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m hex         = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id          = (known after apply)\r\n    }\r\n\r\n\u001b[1m  # tls_private_key.openvidu_ssh_key\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"tls_private_key\" \"openvidu_ssh_key\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m algorithm                     = \"RSA\"\r\n      \u001b[32m+\u001b[0m\u001b[0m ecdsa_curve                   = \"P224\"\r\n      \u001b[32m+\u001b[0m\u001b[0m id                            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m private_key_openssh           = *** value)\r\n      \u001b[32m+\u001b[0m\u001b[0m private_key_pem               = *** value)\r\n      \u001b[32m+\u001b[0m\u001b[0m private_key_pem_pkcs8         = *** value)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_fingerprint_md5    = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_fingerprint_sha256 = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_openssh            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_pem                = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m rsa_bits                      = 4096\r\n    }\r\n\r\n\u001b[1mPlan:\u001b[0m 8 to add, 0 to change, 0 to destroy.\r\n\u001b[0m\r\nChanges to Outputs:\r\n  \u001b[32m+\u001b[0m\u001b[0m appDataBucket          = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m nextStep               = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m publicIp               = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m s3Endpoint             = \"https://fra1.digitaloceanspaces.com\"\r\n  \u001b[32m+\u001b[0m\u001b[0m servicesAndCredentials = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m sshCommand             = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m sshPrivateKey          = *** value)\r\n  \u001b[32m+\u001b[0m\u001b[0m sshUser                = \"root\"\r\n\u001b[90m\r\n───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\nNote: You didn't use the -out option to save this plan, so Terraform can't guarantee to take exactly these actions if\r\nyou run \"terraform apply\" now.\r\n"]
