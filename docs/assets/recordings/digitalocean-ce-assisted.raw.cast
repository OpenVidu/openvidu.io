[42.47,"o","\u001b[2m# Create the machine. deployedBy=instance: it installs OpenVidu on itself with the\r\n# OpenVidu CLI. `apply` returns when Terraform is done (about 1 minute, then OpenVidu installs); OpenVidu comes up after.\u001b[0m\r\n"]
[42.47,"o","$ "]
[42.471,"o","terraform -chdir=.openvidu/digitalocean apply -auto-approve -input=false -no-color\r\n"]
