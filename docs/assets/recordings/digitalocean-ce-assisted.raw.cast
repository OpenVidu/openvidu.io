[42.285,"o","\r\n\u001b[1m  # digitalocean_firewall.openvidu_firewall\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"digitalocean_firewall\" \"openvidu_firewall\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m created_at      = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m droplet_ids     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id              = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m name            = \"openvidu-e2e-do-ce-s094345-firewall\"\r\n      \u001b[32m+\u001b[0m\u001b[0m pending_changes = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m status          = (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m inbound_rule {\r\n          \u001b[32m+\u001b[0m\u001b[0m action                    = \"allow\"\r\n          \u001b[32m+\u001b[0m\u001b[0m port_range                = \"1935\"\r\n          \u001b[32m+\u001b[0m\u001b[0m protocol                  = \"tcp\"\r\n          \u001b[32m+\u001b[0m\u001b[0m source_addresses          = [\r\n              \u001b[32m+\u001b[0m\u001b[0m \"0.0.0.0/0\",\r\n              \u001b[32m+\u001b[0m\u001b[0m \"::/0\",\r\n            ]\r\n          \u001b[32m+\u001b[0m\u001b[0m source_droplet_ids        = []\r\n          \u001b[32m+\u001b[0m\u001b[0m source_kubernetes_ids     = []\r\n          \u001b[32m+\u001b[0m\u001b[0m source_load_balancer_uids = []\r\n          \u001b[32m+\u001b[0m\u001b[0m source_tags               = []\r\n        }\r\n      \u001b[32m+\u001b[0m\u001b[0m inbound_rule {\r\n          \u001b[32m+\u001b[0m\u001b[0m action                    = \"allow\"\r\n          \u001b[32m+\u001b[0m\u001b[0m port_range                = \"22\"\r\n          \u001b[32m+\u001b[0m\u001b[0m protocol                  = \"tcp\"\r\n          \u001b[32m+\u001b[0m\u001b[0m source_addresses          = [\r\n              \u001b[32m+\u001b[0m\u001b[0m \"0.0.0.0/0\",\r\n              \u001b[32m+\u001b[0m\u001b[0m \"::/0\",\r\n            ]\r\n          \u001b[32m+\u001b[0m\u001b[0m source_droplet_ids        = []\r\n          \u001b[32m+\u001b[0m\u001b[0m source_kubernetes_ids     = []\r\n          \u001b[32m+\u001b[0m\u001b[0m source_load_balancer_uids = []\r\n          \u001b[32m+\u001b[0m\u001b[0m source_tags               = []\r\n        }\r\n      \u001b[32m+\u001b[0m\u001b[0m inbound_rule {\r\n          \u001b[32m+\u001b[0m\u001b[0m action                    = \"allow\"\r\n          \u001b[32m+\u001b[0m\u001b[0m port_range                = \"443\"\r\n          \u001b[32m+\u001b[0m\u001b[0m protocol                  = \"tcp\"\r\n          \u001b[32m+\u001b[0m\u001b[0m source_addresses          = [\r\n              \u001b[32m+\u001b[0m\u001b[0m \"0.0.0.0/0\",\r\n              \u001b[32m+\u001b[0m\u001b[0m \"::/0\",\r\n            ]\r\n          \u001b[32m+\u001b[0m\u001b[0m source_droplet_ids        = []\r\n          \u001b[32m+\u001b[0m\u001b[0m source_kubernetes_ids     = []\r\n          \u001b[32m+\u001b[0m\u001b[0m source_load_balancer_uids = []\r\n          \u001b[32m+\u001b[0m\u001b[0m source_tags               = []\r\n        }\r\n      \u001b[32m+\u001b[0m\u001b[0m inbound_rule {\r\n          \u001b[32m+\u001b[0m\u001b[0m action                    = \"allow\"\r\n          \u001b[32m+\u001b[0m\u001b[0m port_range                = \"443\"\r\n          \u001b[32m+\u001b[0m\u001b[0m protocol                  = \"udp\"\r\n          \u001b[32m+\u001b[0m\u001b[0m source_addresses          = [\r\n              \u001b[32m+\u001b[0m\u001b[0m \"0.0.0.0/0\",\r\n              \u001b[32m+\u001b[0m\u001b[0m \"::/0\",\r\n            ]\r\n          \u001b[32m+\u001b[0m\u001b[0m source_droplet_ids        = []\r\n          \u001b[32m+\u001b[0m\u001b[0m source_kubernetes_ids     = []\r\n          \u001b[32m+\u001b[0m\u001b[0m source_load_balancer_uids = []\r\n          \u001b[32m+\u001b[0m\u001b[0m source_tags               = []\r\n        }\r\n      \u001b[32m+\u001b[0m\u001b[0m inbound_rule {\r\n          \u001