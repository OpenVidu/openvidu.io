[66.721,"o","\u001b[2m# Create the machines. deployedBy=instance: master-1 installs OpenVidu with the\r\n# OpenVidu CLI and the other nodes join it. `apply` returns when Terraform is done (about 1 minute, then OpenVidu installs).\u001b[0m\r\n"]
[66.721,"o","$ "]
[66.722,"o","terraform -chdir=.openvidu/digitalocean apply -auto-approve -input=false -no-color\r\n"]
