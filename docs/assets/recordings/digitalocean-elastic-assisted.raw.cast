[118.585,"o","administrationEndpoint = \"https://209.38.255.38:6443\"\r\nappDataBucket = \"openvidu-e2e-do-el-s111429-space-e8b81eabb2\"\r\nmediaNodeTag = \"openvidu-e2e-do-el-s111429-media-node-tag\"\r\nnextStep = \"OpenVidu is deployed and serving, and the media nodes join as the autoscaler creates them. URLs and credentials are in s3://openvidu-e2e-do-el-s111429-space-e8b81eabb2/secrets.env. To administer it from your own machine with the OpenVidu CLI, run what operateFromAnywhere says.\"\r\noperateFromAnywhere = \"terraform output -raw sshPrivateKey > openvidu-e2e-do-el-s111429-key.pem && chmod 600 openvidu-e2e-do-el-s111429-key.pem && mkdir openvidu && cd openvidu && ov stack import openvidu --ssh root@209.38.255.38 --ssh-key ../openvidu-e2e-do-el-s111429-key.pem\"\r\npublicIp = \"209.38.255.38\"\r\ns3Endpoint = \"https://fra1.digitaloceanspaces.com\"\r\nservicesAndCredentials = \"s3://openvidu-e2e-do-el-s111429-space-e8b81eabb2/secrets.env\"\r\nsshCommand = \"ssh root@209.38.255.38\"\r\nsshPrivateKey = ***\r\n"]
