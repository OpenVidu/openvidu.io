[118.764,"o","\u001b[2m# What the stack published: URL, credentials and the stack's access in secrets.env, in the\r\n# stack's Space (the access appears once OpenVidu is up: until then this read fails, and the command that continues the deploy waits for it). Read with the Spaces keys.\u001b[0m\r\n"]
[118.765,"o","$ "]
[118.766,"o","SPACE=\"$(terraform -chdir=.openvidu/digitalocean output -raw appDataBucket)\"\r\n"]
