[701.741,"o","Stack:       openvidu-e2e-do-el-s111429\r\nType:        elastic\r\nEnvironment: digitalocean\r\nEdition:     pro\r\nEndpoint:    https://openvidu-cinvw8-209-38-255-38.sslip.io\r\nSpec:        openvidu-stack.yml\r\nAccess:      remote (from this directory)\r\n\r\nServices:\r\n  ov-livekit-server      1/1   running    openvidu-e2e-do-el-s111429-media-node-1\r\n  ov-egress              1/1   running    openvidu-e2e-do-el-s111429-media-node-1\r\n  ov-ingress             1/1   running    openvidu-e2e-do-el-s111429-media-node-1\r\n  alloy                  2/2   running    openvidu-e2e-do-el-s111429-master-node,openvidu-e2e-do-el-s111429-media-node-1\r\n  caddy-proxy            1/1   running    openvidu-e2e-do-el-s111429-master-node\r\n  grafana                1/1   running    openvidu-e2e-do-el-s111429-master-node\r\n  loki                   1/1   running    openvidu-e2e-do-el-s111429-master-node\r\n  mimir                  1/1   running    openvidu-e2e-do-el-s111429-master-node\r\n  mongodb                1/1   running    openvidu-e2e-do-el-s111429-master-node\r\n  ov-dashboard           1/1   running    openvidu-e2e-do-el-s111429-master-node\r\n  ov-licensing-daemon    2/2   running    openvidu-e2e-do-el-s111429-master-node,openvidu-e2e-do-el-s111429-media-node-1\r\n  ov-livekit-server-internal 1/1   running    openvidu-e2e-do-el-s111429-media-node-1\r\n  ov-meet                1/1   running    openvidu-e2e-do-el-s111429-master-node\r\n  prometheus             1/1   running    openvidu-e2e-do-el-s111429-media-node-1\r\n  redis                  1/1   running    openvidu-e2e-do-el-s111429-master-node\r\n"]
