01b[0m\u001b[0m id                            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m private_key_openssh           = *** value)\r\n      \u001b[32m+\u001b[0m\u001b[0m private_key_pem               = *** value)\r\n      \u001b[32m+\u001b[0m\u001b[0m private_key_pem_pkcs8         = *** value)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_fingerprint_md5    = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_fingerprint_sha256 = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_openssh            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m public_key_pem                = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m rsa_bits                      = 4096\r\n    }\r\n\r\n\u001b[1mPlan:\u001b[0m 17 to add, 0 to change, 0 to destroy.\r\n\u001b[0m\r\nChanges to Outputs:\r\n  \u001b[32m+\u001b[0m\u001b[0m administrationEndpoint = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m appDataBucket          = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m mediaNodeTag           = \"openvidu-e2e-do-el-s111429-media-node-tag\"\r\n  \u001b[32m+\u001b[0m\u001b[0m nextStep               = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m operateFromAnywhere    = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m publicIp               = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m s3Endpoint             = \"https://fra1.digitaloceanspaces.com\"\r\n  \u001b[32m+\u001b[0m\u001b[0m servicesAndCredentials = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m sshCommand             = (known after apply)\r\n  \u001b[32m+\u001b[0m\u001b[0m sshPrivateKey          = *** value)\r\n\u001b[90m\r\n───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\nNote: You didn't use the -out option to save this plan, so Terraform can't guarantee to take exactly these actions if\r\nyou run \"terraform apply\" now.\r\n"]
