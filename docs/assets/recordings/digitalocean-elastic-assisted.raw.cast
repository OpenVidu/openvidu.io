[67.382,"o","\r\n  # digitalocean_firewall.master_firewall will be created\r\n  + resource \"digitalocean_firewall\" \"master_firewall\" {\r\n      + created_at      = (known after apply)\r\n      + droplet_ids     = (known after apply)\r\n      + id              = (known after apply)\r\n      + name            = \"openvidu-e2e-do-el-s111429-master-firewall\"\r\n      + pending_changes = (known after apply)\r\n      + status          = (known after apply)\r\n\r\n      + inbound_rule {\r\n          + action                    = \"allow\"\r\n          + port_range                = \"1935\"\r\n          + protocol                  = \"tcp\"\r\n          + source_addresses          = [\r\n              + \"0.0.0.0/0\",\r\n              + \"::/0\",\r\n            ]\r\n          + source_droplet_ids        = []\r\n          + source_kubernetes_ids     = []\r\n          + source_load_balancer_uids = []\r\n          + source_tags               = []\r\n        }\r\n      + inbound_rule {\r\n          + action                    = \"allow\"\r\n          + port_range                = \"22\"\r\n          + protocol                  = \"tcp\"\r\n          + source_addresses          = [\r\n              + \"0.0.0.0/0\",\r\n              + \"::/0\",\r\n            ]\r\n          + source_droplet_ids        = []\r\n          + source_kubernetes_ids     = []\r\n          + source_load_balancer_uids = []\r\n          + source_tags               = []\r\n        }\r\n      + inbound_rule {\r\n          + action                    = \"allow\"\r\n          + port_range                = \"443\"\r\n          + protocol                  = \"tcp\"\r\n          + source_addresses          = [\r\n              + \"0.0.0.0/0\",\r\n              + \"::/0\",\r\n            ]\r\n          + source_droplet_ids        = []\r\n          + source_kubernetes_ids     = []\r\n          + source_load_balancer_uids = []\r\n          + source_tags               = []\r\n        }\r\n      + inbound_rule {\r