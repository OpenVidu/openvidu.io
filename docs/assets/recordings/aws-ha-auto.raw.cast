[1.144,"o","ov stack deploy openvidu-e2e-aws-ha-a102129 --cloud aws --aws-region \"$AWS_REGION\" --edition pro --openvidu-pro-license \"$OPENVIDU_PRO_LICENSE\" --deployment-type ha --domain-name \"$AWS_HA_DOMAIN_NAME\" --param HostedZoneId=\"$AWS_HA_HOSTED_ZONE_ID\" --mode auto -y\r\n"]
